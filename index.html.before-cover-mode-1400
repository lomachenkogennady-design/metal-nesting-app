<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>ФАЙЕРПРОМ — Автономный калькулятор КП, DXF, 2D/3D и раскрой</title>
  <meta name="description" content="Автономное приложение для расчёта КП, гибки, 2D/3D чертежей и раскроя листового металла без сервера">
  <meta name="theme-color" content="#2b6cb0">
    <!-- Three.js для 3D WebGL (с локальным fallback) -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <style>
    :root {
      --bg: #eef1f6;
      --card: #ffffff;
      --txt: #2d3748;
      --acc: #3182ce;
      --acc-hover: #2b6cb0;
      --brd: #e2e8f0;
      --hint: #718096;
      --ok: #22543d;
      --ok-bg: #c6f6d5;
      --warn: #92400e;
      --warn-bg: #feebc8;
      --danger: #c53030;
      --danger-bg: #fed7d7;
      --input: #ffffff;
    }
    body.dark {
      --bg: #161a21;
      --card: #1e242e;
      --txt: #e2e8f0;
      --acc: #63b3ed;
      --acc-hover: #4299e1;
      --brd: #2d3748;
      --hint: #a0aec0;
      --ok: #9ae6b4;
      --ok-bg: #22543d;
      --warn: #fbd38d;
      --warn-bg: #744210;
      --danger: #feb2b2;
      --danger-bg: #742a2a;
      --input: #131820;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; min-height: 100%; background: var(--bg); color: var(--txt); font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; -webkit-font-smoothing: antialiased; }
    button, input, select, textarea { font: inherit; color: inherit; }
    button { cursor: pointer; border: none; background: transparent; }

    /* Верхняя панель */
    .topbar { position: sticky; top: 0; z-index: 50; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; padding: 10px 18px; background: var(--card); border-bottom: 1px solid var(--brd); box-shadow: 0 1px 4px rgba(0,0,0,0.04); }
    .brand { display: flex; align-items: center; gap: 10px; }
    .logo { width: 36px; height: 36px; border-radius: 9px; background: linear-gradient(135deg, #2b6cb0, #3182ce); color: #fff; display: grid; place-items: center; font-weight: 800; font-size: 14px; }
    .brand-title strong { display: block; font-size: 15px; font-weight: 800; }
    .brand-title small { font-size: 10px; color: var(--hint); }

    .nav-tabs { display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none; }
    .nav-tabs::-webkit-scrollbar { display: none; }
    .tab-btn { padding: 8px 14px; border-radius: 8px; font-size: 12px; font-weight: 700; color: var(--hint); transition: all 0.15s ease; white-space: nowrap; }
    .tab-btn.active { color: var(--acc); background: var(--bg); }

    .top-actions { display: flex; align-items: center; gap: 8px; }
    .btn-offline-save { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; background: #276749; color: #fff; border-radius: 8px; font-size: 11px; font-weight: 700; text-decoration: none; box-shadow: 0 2px 6px rgba(39, 103, 73, 0.3); }
    .btn-theme { padding: 6px 10px; border: 1px solid var(--brd); border-radius: 8px; font-size: 13px; }

    /* Основная сетка */
    .layout { display: grid; grid-template-columns: minmax(0, 1fr) 350px; gap: 16px; max-width: 1500px; margin: 0 auto; padding: 16px 18px 40px; align-items: start; }
    @media (max-width: 1024px) { .layout { grid-template-columns: 1fr; } }

    .main-col, .side-col { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
    .side-col { position: sticky; top: 70px; }
    @media (max-width: 1024px) { .side-col { position: static; } }

    .card { background: var(--card); border: 1px solid var(--brd); border-radius: 12px; padding: 16px 18px; box-shadow: 0 2px 8px rgba(0,0,0,0.02); }
    .card-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; flex-wrap: wrap; gap: 8px; }
    .card-head h2 { margin: 0; font-size: 14px; font-weight: 750; }
    .link-btn { color: var(--acc); font-size: 11px; font-weight: 700; padding: 0; }
    .hint { font-size: 11px; color: var(--hint); margin: 6px 0 0; line-height: 1.4; }

    /* Поля ввода и сетка */
    .grid4 { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 10px; }
    @media (max-width: 600px) { .grid4 { grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); } }
    .fld { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
    .fld > span { font-size: 10px; font-weight: 600; color: var(--hint); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .fld input, .fld select { width: 100%; height: 34px; padding: 0 8px; border: 1px solid var(--brd); border-radius: 8px; background: var(--input); font-size: 12px; }
    .fld input:focus, .fld select:focus { outline: 2px solid var(--acc); outline-offset: -1px; }

    .btn-primary { background: var(--acc); color: #fff; padding: 7px 14px; border-radius: 8px; font-size: 11px; font-weight: 700; transition: all 0.15s ease; }
    .btn-primary:hover { background: var(--acc-hover); }
    .btn-primary.sm { padding: 5px 10px; font-size: 11px; }
    .btn-primary.wide { width: 100%; padding: 10px; font-size: 12px; margin-top: 10px; }
    .btn-primary:disabled { background: var(--hint); opacity: 0.6; cursor: not-allowed; }

    /* Таблица позиций */
    .table-scroll { overflow-x: auto; }
    table.pos { width: 100%; min-width: 900px; border-collapse: collapse; font-size: 11px; }
    table.pos th { padding: 6px 4px 8px; color: var(--hint); font-size: 9px; font-weight: 700; text-transform: uppercase; text-align: left; }
    table.pos td { padding: 3px 4px; border-top: 1px solid var(--brd); }
    table.pos input, table.pos select { height: 30px; width: 100%; border: 1px solid var(--brd); border-radius: 6px; background: var(--input); padding: 0 6px; font-size: 11px; }
    table.pos td:first-child input { min-width: 140px; }
    table.pos .sum { color: var(--ok); font-weight: 700; text-align: right; white-space: nowrap; }
    .del-btn { width: 26px; height: 26px; border-radius: 6px; color: var(--danger); font-size: 16px; font-weight: 700; display: grid; place-items: center; }
    .del-btn:hover { background: var(--danger-bg); }

    /* Калькуляция */
    .calc-row { display: flex; justify-content: space-between; padding: 5px 0; font-size: 11px; }
    .calc-row span { color: var(--hint); }
    .calc-row b { font-weight: 700; }
    .calc-row.warn b { color: var(--warn); }
    .grand-total { display: flex; justify-content: space-between; align-items: center; margin-top: 10px; padding: 12px; border-radius: 9px; background: rgba(49, 130, 206, 0.1); font-size: 12px; font-weight: 700; }
    .grand-total strong { font-size: 17px; color: var(--acc); }

    .action-grid { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
    .action-grid button, .action-grid label { padding: 7px 11px; border: 1px solid var(--brd); border-radius: 7px; background: var(--card); font-size: 11px; font-weight: 600; }
    .action-grid label input { display: none; }
    .action-grid button.danger { color: var(--danger); }

    /* Памятка и бейджи */
    .memo-box { background: var(--card); border: 1px solid var(--brd); border-left: 4px solid var(--acc); border-radius: 8px; padding: 12px 14px; margin: 10px 0; font-size: 11px; }
    .memo-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    @media (max-width: 600px) { .memo-grid { grid-template-columns: 1fr; } }
    .memo-grid ul { margin: 4px 0 0 16px; padding: 0; line-height: 1.5; }
    .memo-warn { margin-top: 8px; padding: 6px 8px; background: var(--warn-bg); color: var(--warn); border-radius: 6px; font-weight: 600; }

    .badge-tag { display: inline-flex; align-items: center; gap: 4px; padding: 2px 7px; border-radius: 6px; font-size: 10px; font-weight: 700; background: rgba(49,130,206,0.1); color: var(--acc); }
    .notice-item { padding: 6px 9px; border-radius: 6px; font-size: 11px; margin-top: 6px; }
    .notice-item.error { background: var(--danger-bg); color: var(--danger); }
    .notice-item.warning { background: var(--warn-bg); color: var(--warn); }

    /* Миниатюры деталей в таблице */
    .thumb-cell-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
      padding: 2px;
      background: transparent;
      border: 1px solid transparent;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.15s ease;
      width: 100%;
    }
    .thumb-cell-btn:hover {
      border-color: var(--acc);
      background: rgba(49, 130, 206, 0.08);
      transform: scale(1.04);
    }
    .thumb-hover-tag {
      font-size: 8.5px;
      font-weight: 700;
      color: var(--acc);
      white-space: nowrap;
    }

    /* Модальное окно 2D/3D инспекции изделия */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      z-index: 100;
      background: rgba(15, 23, 42, 0.65);
      backdrop-filter: blur(4px);
      display: grid;
      place-items: center;
      padding: 16px;
      overflow-y: auto;
    }
    .modal-window {
      background: var(--card);
      border: 1px solid var(--brd);
      border-radius: 14px;
      width: min(920px, 96vw);
      max-height: 92vh;
      overflow-y: auto;
      padding: 20px 22px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
    }
    .modal-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 12px;
      border-bottom: 1px solid var(--brd);
      padding-bottom: 12px;
    }

    /* 3D и 2D вьюверы */
    .viewer-container { width: 100%; height: 350px; border-radius: 10px; border: 1px solid var(--brd); background: #f8fafc; overflow: hidden; position: relative; cursor: grab; }
    body.dark .viewer-container { background: #131820; }
    .viewer-container:active { cursor: grabbing; }
    .viewer-bar { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin-top: 8px; font-size: 11px; }
    .viewer-bar button { padding: 5px 9px; border: 1px solid var(--brd); border-radius: 6px; font-size: 10px; font-weight: 600; background: var(--card); }
    .viewer-bar button.active { border-color: var(--acc); color: var(--acc); }
    .svg-canvas { width: 100%; max-height: 420px; border: 1px solid var(--brd); border-radius: 10px; background: #fff; }

    /* Раскрой */
    .sheet-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px; margin-top: 12px; }
    .sheet-card { border: 1px solid var(--brd); border-radius: 10px; padding: 10px; background: var(--bg); display: flex; flex-direction: column; gap: 8px; }
    .sheet-card header { display: flex; justify-content: space-between; font-size: 11px; font-weight: 700; }

    /* Стенд тестов */
    .test-box { padding: 10px; border: 1px solid var(--brd); border-radius: 8px; font-size: 11px; margin-bottom: 6px; display: flex; justify-content: space-between; align-items: center; }
    .test-box.pass { background: rgba(39, 103, 73, 0.05); border-left: 4px solid #276749; }
    .test-box.fail { background: rgba(229, 62, 62, 0.08); border-left: 4px solid #c53030; }

    /* Печать */
    @media print {
      body * { visibility: hidden; }
      #print-area, #print-area * { visibility: visible; }
      #print-area { position: absolute; left: 0; top: 0; width: 100%; padding: 0 10mm; font-size: 11pt; color: #000; }
    }
    #print-area { display: none; }
    @media print { #print-area { display: block; } }
  </style>
</head>
<body>

  <!-- Верхняя шапка -->
  <header class="topbar">
    <div class="brand">
      <div class="logo">ФП</div>
      <div class="brand-title">
        <strong>ФАЙЕРПРОМ · Offline</strong>
        <small>Автономное приложение (без сервера)</small>
      </div>
    </div>

    <nav class="nav-tabs">
      <button class="tab-btn active" onclick="setTab('kp')">Калькулятор КП</button>
      <button class="tab-btn" onclick="setTab('designer')">Чертёж 2D · 3D · раскрой</button>
      <button class="tab-btn" onclick="setTab('tests')">🧪 Тесты (160)</button>
    </nav>

    <div class="top-actions">
      <a href="javascript:downloadSelf()" class="btn-offline-save" title="Сохранить этот файл себе на смартфон">
        💾 Сохранить файл на телефон
      </a>
      <button class="btn-theme" onclick="toggleDark()" title="Сменить тему">🌓</button>
    </div>
  </header>

  <!-- ВКЛАДКА 1: КАЛЬКУЛЯТОР КП -->
  <div id="tab-kp" class="layout">
    <div class="main-col">

      <!-- Реквизиты -->
      <div class="card">
        <div class="card-head">
          <h2>1. Реквизиты коммерческого предложения</h2>
          <button class="link-btn" onclick="toggleReq()">Развернуть / Свернуть</button>
        </div>
        <div class="grid4">
          <label class="fld">
            <span>№ КП</span>
            <input type="text" id="docNum" value="КП-0001" onchange="calcAll()">
          </label>
          <label class="fld">
            <span>Дата</span>
            <input type="date" id="docDate" onchange="calcAll()">
          </label>
          <label class="fld">
            <span>Заказчик</span>
            <input type="text" id="kName" placeholder="ООО Заказчик" onchange="calcAll()">
          </label>
          <label class="fld">
            <span>Срок изготовления</span>
            <input type="text" id="dTerm" value="10 рабочих дней" onchange="calcAll()">
          </label>
        </div>

        <div id="extra-req" style="display:none; margin-top:10px;" class="grid4">
          <label class="fld"><span>Исполнитель</span><input type="text" id="cName" value="ООО «ФАЙЕРПРОМ»"></label>
          <label class="fld"><span>ИНН</span><input type="text" id="cINN" value="7700000000"></label>
          <label class="fld"><span>Телефон</span><input type="text" id="cPhone" value="+7 (495) 000-00-00"></label>
          <label class="fld"><span>Менеджер</span><input type="text" id="mName" value="Игорь Вороненков"></label>
          <label class="fld"><span>Предоплата</span><input type="text" id="prepay" value="50%"></label>
          <label class="fld"><span>Срок действия КП</span><input type="text" id="dValid" value="14 дней"></label>
        </div>
      </div>

      <!-- Материал -->
      <div class="card">
        <div class="card-head">
          <h2>2. Материал металла</h2>
          <span class="badge-tag" id="mat-limit-badge">Лимит станка: до 5 мм</span>
        </div>
        <div class="grid4">
          <label class="fld">
            <span>Марка металла</span>
            <select id="matSelect" onchange="onMatChange()">
              <option value="galv" data-d="7850" data-p="74.83" data-max="5">ОЦ — оцинковка (74.83 ₽/кг)</option>
              <option value="cold" data-d="7850" data-p="61.27" data-max="5">ХК — холоднокатаная (61.27 ₽/кг)</option>
              <option value="ss" data-d="7900" data-p="311.47" data-max="3">Нержавеющая сталь AISI 304 (311.47 ₽/кг)</option>
              <option value="hot" data-d="7850" data-p="65.00" data-max="5">ГК — горячекатаная (65.00 ₽/кг)</option>
              <option value="alu" data-d="2700" data-p="320.00" data-max="3">Алюминий АМг2 (320.00 ₽/кг)</option>
              <option value="cu" data-d="8900" data-p="780.00" data-max="0">Медь М1 (780.00 ₽/кг, по запросу)</option>
            </select>
          </label>
          <label class="fld">
            <span>Плотность, кг/м³</span>
            <input type="number" id="matDensity" value="7850" readonly>
          </label>
          <label class="fld">
            <span>Цена, ₽/кг</span>
            <input type="number" step="0.1" id="matPrice" value="74.83" onchange="calcAll()">
          </label>
          <label class="fld" style="justify-content: flex-end;">
            <label style="display:flex; align-items:center; gap:6px; font-size:11px; height:34px;">
              <input type="checkbox" id="ownPrice" onchange="onOwnPriceChange()"> Своя цена металла
            </label>
          </label>
        </div>
      </div>

      <!-- Таблица деталей -->
      <div class="card">
        <div class="card-head">
          <h2>3. Спецификация позиций</h2>
          <button class="btn-primary sm" onclick="addPosition()">+ Добавить деталь</button>
        </div>
        <div class="table-scroll">
          <table class="pos">
            <thead>
              <tr>
                <th style="width:70px; text-align:center;">Эскиз 2D/3D</th>
                <th>Наименование</th>
                <th style="width:65px">Кол-во</th>
                <th style="width:75px">Ш, мм</th>
                <th style="width:75px">В, мм</th>
                <th style="width:80px">Площадь м²</th>
                <th style="width:75px">Толщ S</th>
                <th style="width:75px">Рез, м</th>
                <th style="width:65px">Врезки</th>
                <th style="width:65px">Гибы</th>
                <th style="width:90px; text-align:right">Сумма ₽</th>
                <th style="width:30px"></th>
              </tr>
            </thead>
            <tbody id="pos-tbody">
              <!-- Динамические строки -->
            </tbody>
          </table>
        </div>
        <p class="hint">Ширина и высота автоматически рассчитывают площадь. Толщина влияет на вес и тариф гибки.</p>
      </div>

      <!-- Резка и Гибка -->
      <div class="card">
        <div class="card-head">
          <h2>4. Резка, гибка и обработка</h2>
          <span class="badge-tag">Памятка: макс. рез 2490×1240 · пресс до 2490 мм</span>
        </div>
        <div class="grid4">
          <label class="fld">
            <span>Тип резки</span>
            <select id="cutType" onchange="onCutTypeChange()">
              <option value="50">Лазерная резка (50 ₽/м)</option>
              <option value="35">Плазменная резка (35 ₽/м)</option>
              <option value="120">Гидроабразив (120 ₽/м)</option>
            </select>
          </label>
          <label class="fld"><span>Цена реза, ₽/м</span><input type="number" id="cutPrice" value="50" onchange="calcAll()"></label>
          <label class="fld"><span>Норматив врезки (м)</span><input type="number" step="0.01" id="pierceFee" value="0.15" onchange="calcAll()"></label>
          <label class="fld"><span>Гиб до 2 мм, ₽</span><input type="number" id="b1" value="25" onchange="calcAll()"></label>
          <label class="fld"><span>Гиб 2–4 мм, ₽</span><input type="number" id="b2" value="40" onchange="calcAll()"></label>
          <label class="fld"><span>Гиб 4–8 мм, ₽</span><input type="number" id="b3" value="70" onchange="calcAll()"></label>
          <label class="fld"><span>Гиб &gt;8 мм, ₽</span><input type="number" id="b4" value="120" onchange="calcAll()"></label>
        </div>
      </div>

      <!-- Покраска RAL, плёнка, пескоструй -->
      <div class="card">
        <div class="card-head">
          <h2>5. Покраска, защитная плёнка и доп. услуги</h2>
          <span class="badge-tag">По разделам 3 и 4 Памятки</span>
        </div>
        <div class="grid4">
          <label class="fld"><span>Порошковая окраска, м²</span><input type="number" step="0.01" id="paintArea" value="0" onchange="calcAll()"></label>
          <label class="fld"><span>Цена окраски, ₽/м²</span><input type="number" id="paintPrice" value="350" onchange="calcAll()"></label>
          <label class="fld">
            <span>Цвет по каталогу RAL</span>
            <select id="ralColor" onchange="calcAll()">
              <option value="RAL 9005">RAL 9005 (Глубокий чёрный)</option>
              <option value="RAL 9003">RAL 9003 (Сигнальный белый)</option>
              <option value="RAL 7016">RAL 7016 (Антрацитово-серый)</option>
              <option value="RAL 7024">RAL 7024 (Графитовый серый)</option>
              <option value="RAL 7040">RAL 7040 (Серое окно)</option>
              <option value="RAL 8017">RAL 8017 (Шоколадный)</option>
              <option value="RAL 3020">RAL 3020 (Красный)</option>
              <option value="RAL 5005">RAL 5005 (Сигнальный синий)</option>
              <option value="RAL 6005">RAL 6005 (Зелёный мох)</option>
              <option value="Спец. RAL">Другой спец. RAL...</option>
            </select>
          </label>
          <label class="fld">
            <span>Защитная плёнка (сторона)</span>
            <select id="filmSide" onchange="calcAll()">
              <option value="none">Без защитной плёнки</option>
              <option value="one">С 1 стороны (+60 ₽/м²)</option>
              <option value="two">С 2-х сторон (+120 ₽/м²)</option>
            </select>
          </label>
          <label class="fld"><span>Пескоструй, м²</span><input type="number" step="0.01" id="sandArea" value="0" onchange="calcAll()"></label>
          <label class="fld"><span>Пескоструй, ₽/м²</span><input type="number" id="sandPrice" value="280" onchange="calcAll()"></label>
          <label class="fld"><span>Сварка, м</span><input type="number" step="0.1" id="weldM" value="0" onchange="calcAll()"></label>
