    /* ---------------- 2. Инспекция каждого изделия (2D / 3D / Гибка) ---------------- */
    function inspectPosition(idx) {
      modalPosIndex = idx;
      const pos = positions[idx];
      if (!pos) return;

      const title = document.getElementById('pos-modal-title'); if (title) title.textContent = pos.name;
      const badge = document.getElementById('pos-modal-badge'); if (badge) badge.textContent = `${pos.w} × ${pos.h} мм · S ${pos.t} мм`;
      const dims = document.getElementById('pos-modal-dims'); if (dims) dims.textContent = `Кол-во: ${pos.q} шт · Площадь: ${pos.a} м² · Рез: ${pos.c} м · Врезок: ${pos.p} · Гибов: ${pos.b}`;

      const bendBtn = document.getElementById('pos-modal-btn-bend');
      if (bendBtn) bendBtn.textContent = (pos.bends && pos.bends.length > 0) ? `Гибка (${pos.bends.length})` : 'Гибка';

      const modal = document.getElementById('pos-modal');
      if (modal) modal.style.display = 'grid';
      fitPosModal2D();
      switchModalView('2d');
