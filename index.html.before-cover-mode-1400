  <script>
    
    /* ==== fpBuildShape: сшивка сегментов DXF в замкнутый контур + holes ==== */
    function fpBuildShape(segs, circles, w, h) {
      var contours = [];
      if (segs && segs.length > 0) {
        var eps = 0.5;
        var key = function(x, y) { return Math.round(x/eps) + '_' + Math.round(y/eps); };
        var used = new Array(segs.length).fill(false);
        var graph = {};
        segs.forEach(function(s, i) {
          var k1 = key(s.x1, s.y1);
          var k2 = key(s.x2, s.y2);
          (graph[k1] = graph[k1] || []).push(i);
          (graph[k2] = graph[k2] || []).push(i);
        });
        for (var i = 0; i < segs.length; i++) {
          if (used[i]) continue;
          var contour = [];
          var curPoint = { x: segs[i].x2, y: segs[i].y2 };
          contour.push({ x: segs[i].x1, y: segs[i].y1 });
          used[i] = true;
          var safety = 0;
          while (safety++ < segs.length + 5) {
            contour.push({ x: curPoint.x, y: curPoint.y });
            var k = key(curPoint.x, curPoint.y);
            var candidates = graph[k] || [];
            var next = -1;
            for (var c2 = 0; c2 < candidates.length; c2++) {
              if (!used[candidates[c2]]) { next = candidates[c2]; break; }
            }
            if (next < 0) break;
            var s2 = segs[next];
            if (key(s2.x1, s2.y1) === k) {
              curPoint = { x: s2.x2, y: s2.y2 };
            } else {
              curPoint = { x: s2.x1, y: s2.y1 };
            }
            used[next] = true;
          }
          if (contour.length >= 3) contours.push(contour);
        }
      }
      if (contours.length === 0) {
        contours.push([
          { x: 0, y: 0 }, { x: w, y: 0 }, { x: w, y: h }, { x: 0, y: h }
        ]);
      }
      function polyArea(c) {
        var s = 0;
        for (var i = 0; i < c.length; i++) {
          var a = c[i], b = c[(i+1) % c.length];
          s += a.x * b.y - b.x * a.y;
        }
        return Math.abs(s / 2);
      }
      contours.forEach(function(c2) { c2._area = polyArea(c2); });
      contours.sort(function(a, b) { return b._area - a._area; });

      var outer = contours[0];
      var shape = new THREE.Shape();
      shape.moveTo(outer[0].x - w/2, outer[0].y - h/2);
      for (var i = 1; i < outer.length; i++) {
        shape.lineTo(outer[i].x - w/2, outer[i].y - h/2);
      }
      shape.closePath();

      for (var k = 1; k < contours.length; k++) {
        var hc = contours[k];
        var holePath = new THREE.Path();
        holePath.moveTo(hc[0].x - w/2, hc[0].y - h/2);
        for (var j = 1; j < hc.length; j++) {
          holePath.lineTo(hc[j].x - w/2, hc[j].y - h/2);
        }
        holePath.closePath();
        shape.holes.push(holePath);
      }

      if (circles && circles.length > 0) {
        circles.forEach(function(c3) {
          var hp = new THREE.Path();
          hp.absarc(c3.cx - w/2, c3.cy - h/2, Math.max(0.5, c3.r), 0, Math.PI*2, true);
          shape.holes.push(hp);
        });
      }

      return shape;
    }

    /* ====================================================================
       ЛОГИКА АВТОНОМНОГО ПРИЛОЖЕНИЯ ФАЙЕРПРОМ (V3 ROBUST)
       ==================================================================== */
    const safeStorage = {
      getItem(k) { try { return localStorage.getItem(k); } catch(e) { return null; } },
      setItem(k, v) { try { localStorage.setItem(k, v); } catch(e) {} },
      removeItem(k) { try { localStorage.removeItem(k); } catch(e) {} }
    };

    var currentTab = 'kp';
    var positions = [];
    var designerParts = [];
    var activePartIndex = 0;
    var currentDesignView = '2d';
    var threeScene, threeCamera, threeRenderer, threeMesh, threeAnimFrame;
    var threeSpin = true;
    var idealDist3D = 600;

    var zoom2D = 1;
    var pan2D = { x: 0, y: 0 };
    var isDragging2D = false;
    var startPtr2D = { x: 0, y: 0 };

    var modalPosIndex = 0;
    var pmModalView = '2d';
    var pmZoom2D = 1;
    var pmPan2D = { x: 0, y: 0 };
    var pmIsDragging = false;
    var pmStartPtr = { x: 0, y: 0 };
    var pmThreeScene, pmThreeCamera, pmThreeRenderer, pmThreeMesh, pmAnimFrame;
    var pmSpin = true;
    var pmIdealDist = 600;

    function initApp() {
      const docDate = document.getElementById('docDate');
      if (docDate && !docDate.value) docDate.value = new Date().toISOString().slice(0, 10);
      loadSavedState();
      if (positions.length === 0) {
        addPosition("Деталь 1", 1, 500, 400, 0.2000, 1.5, 1.80, 1, 0);
      }
      calcAll();
      renderSavedQuotesList();
      generateShapeUI();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initApp);
    } else {
      initApp();
    }

    // Смена вкладок
    function setTab(tab) {
      currentTab = tab;
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      const kpEl = document.getElementById('tab-kp');
      const desEl = document.getElementById('tab-designer');
      const testEl = document.getElementById('tab-tests');
      if (kpEl) kpEl.style.display = tab === 'kp' ? 'grid' : 'none';
      if (desEl) desEl.style.display = tab === 'designer' ? 'grid' : 'none';
      if (testEl) testEl.style.display = tab === 'tests' ? 'grid' : 'none';

      const btnMap = { kp: 0, designer: 1, tests: 2 };
      const btn = document.querySelectorAll('.tab-btn')[btnMap[tab]];
      if (btn) btn.classList.add('active');

      if (tab === 'designer') {
        if (designerParts.length === 0 && positions.length > 0) {
          syncPositionsToDesigner();
        }
        renderCurrentPartView();
      } else if (tab === 'tests') {
        runAllTests();
      }
    }

    function toggleDark() {
      document.body.classList.toggle('dark');
    }

    function toggleReq() {
      const el = document.getElementById('extra-req');
      if (el) el.style.display = el.style.display === 'none' ? 'grid' : 'none';
    }

    function toggleMemoModal() {
      const el = document.getElementById('memo-block');
      if (el) el.style.display = el.style.display === 'none' ? 'block' : 'none';
    }

    function downloadSelf() {
      const htmlContent = "<!DOCTYPE html>\n" + document.documentElement.outerHTML;
      const blob = new Blob([htmlContent], { type: 'text/html;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'fayerprom-offline.html';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(a.href);
      alert('Файл "fayerprom-offline.html" успешно сохранён на ваше устройство!');
    }

    /* ---------------- 1. Калькулятор КП ---------------- */
    function onMatChange() {
      const sel = document.getElementById('matSelect');
      if (!sel) return;
      const opt = sel.options[sel.selectedIndex];
      document.getElementById('matDensity').value = opt.getAttribute('data-d');
      if (!document.getElementById('ownPrice').checked) {
        document.getElementById('matPrice').value = opt.getAttribute('data-p');
      }
      const maxT = opt.getAttribute('data-max');
      const badge = document.getElementById('mat-limit-badge');
      if (badge) {
        badge.textContent = maxT === '0' 
          ? '⚠️ Цветной металл: по запросу' 
          : `Лимит станка: до ${maxT} мм`;
      }
      calcAll();
    }

    function onOwnPriceChange() {
      const own = document.getElementById('ownPrice').checked;
      const matP = document.getElementById('matPrice');
      if (matP) matP.disabled = !own;
      if (!own) onMatChange();
    }

    function onCutTypeChange() {
      const cutP = document.getElementById('cutPrice');
      const cutT = document.getElementById('cutType');
      if (cutP && cutT) cutP.value = cutT.value;
      calcAll();
    }

    function getThumbSvg(pos, w=58, h=38) {
      const pad = 4;
      const availW = w - pad * 2;
      const availH = h - pad * 2;
      const pw = Math.max(10, pos.w || 400);
      const ph = Math.max(10, pos.h || 300);
      const sc = Math.min(availW / pw, availH / ph);
      const ox = (w - pw * sc) / 2;
      const oy = (h - ph * sc) / 2;

      let s = `<svg viewBox="0 0 ${w} ${h}" width="${w}" height="${h}" style="background:#ffffff;border:1px solid var(--brd);border-radius:5px;display:block;">`;
      s += `<rect width="${w}" height="${h}" fill="#ffffff"/>`;

      if (pos.segs && pos.segs.length > 0) {
        pos.segs.forEach(seg => {
          s += `<line x1="${(ox + seg.x1 * sc).toFixed(1)}" y1="${(oy + seg.y1 * sc).toFixed(1)}" x2="${(ox + seg.x2 * sc).toFixed(1)}" y2="${(oy + seg.y2 * sc).toFixed(1)}" stroke="#1a365d" stroke-width="1.3" stroke-linecap="round"/>`;
        });
      } else {
        s += `<rect x="${ox.toFixed(1)}" y="${oy.toFixed(1)}" width="${(pw * sc).toFixed(1)}" height="${(ph * sc).toFixed(1)}" fill="rgba(49,130,206,0.18)" stroke="#1a365d" stroke-width="1.3"/>`;
      }

      if (pos.circles && pos.circles.length > 0) {
        pos.circles.forEach(c => {
          s += `<circle cx="${(ox + c.cx * sc).toFixed(1)}" cy="${(oy + c.cy * sc).toFixed(1)}" r="${Math.max(1.2, c.r * sc).toFixed(1)}" fill="#ffffff" stroke="#c05621" stroke-width="1"/>`;
        });
      }

      if (pos.bends && pos.bends.length > 0) {
        pos.bends.forEach(b => {
          const bx = ox + (b.pos || b.position || 0) * sc;
          s += `<line x1="${bx.toFixed(1)}" y1="${oy.toFixed(1)}" x2="${bx.toFixed(1)}" y2="${(oy + ph * sc).toFixed(1)}" stroke="#dd6b20" stroke-width="1" stroke-dasharray="2 1.5"/>`;
        });
      }

      s += `</svg>`;
      return s;
    }

    function addPosition(name="Деталь", q=1, w=500, h=400, a=0.2000, t=1.5, c=1.80, p=1, b=0, segs=null, circles=null, bends=null) {
      if (!segs || segs.length === 0) {
        segs = [
          { x1: 0, y1: 0, x2: w, y2: 0 },
          { x1: w, y1: 0, x2: w, y2: h },
          { x1: w, y1: h, x2: 0, y2: h },
          { x1: 0, y1: h, x2: 0, y2: 0 }
        ];
      }
      positions.push({
        id: 'p_' + Date.now() + '_' + Math.random().toString(36).substr(2, 4),
        name, q, w, h, a, t, c, p, b,
        segs,
        circles: circles || [],
        bends: bends || []
      });
      renderPositionsTable();
      calcAll();
    }

    function removePosition(idx) {
      positions.splice(idx, 1);
      if (positions.length === 0) addPosition();
      renderPositionsTable();
      calcAll();
    }

    function updatePos(idx, field, val) {
      if (!positions[idx]) return;
      const num = parseFloat(val) || 0;
      positions[idx][field] = field === 'name' ? val : num;
      if (field === 'w' || field === 'h') {
        const pw = Math.max(10, positions[idx].w || 10);
        const ph = Math.max(10, positions[idx].h || 10);
        positions[idx].a = Number(((pw * ph) / 1e6).toFixed(4));
        if (!positions[idx].isCustomDxf) {
          positions[idx].segs = [
            { x1: 0, y1: 0, x2: pw, y2: 0 },
            { x1: pw, y1: 0, x2: pw, y2: ph },
            { x1: pw, y1: ph, x2: 0, y2: ph },
            { x1: 0, y1: ph, x2: 0, y2: 0 }
          ];
          positions[idx].c = Number(((pw * 2 + ph * 2) / 1000).toFixed(2));
        }
      }
      renderPositionsTable();
      calcAll();
    }

    function renderPositionsTable() {
      const tbody = document.getElementById('pos-tbody');
      if (!tbody) return;
      tbody.innerHTML = '';
      positions.forEach((pos, i) => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td style="width:70px; text-align:center; padding:2px;">
            <button type="button" class="thumb-cell-btn" onclick="inspectPosition(${i})" title="Посмотреть 2D чертёж и 3D модель изделия">
              ${getThumbSvg(pos, 58, 38)}
              <span class="thumb-hover-tag">👁️ 2D/3D</span>
            </button>
          </td>
          <td><input type="text" value="${pos.name}" oninput="updatePos(${i},'name',this.value)" onchange="updatePos(${i},'name',this.value)"></td>
          <td><input type="number" min="1" value="${pos.q}" oninput="updatePos(${i},'q',this.value)" onchange="updatePos(${i},'q',this.value)"></td>
          <td><input type="number" value="${pos.w}" oninput="updatePos(${i},'w',this.value)" onchange="updatePos(${i},'w',this.value)"></td>
          <td><input type="number" value="${pos.h}" oninput="updatePos(${i},'h',this.value)" onchange="updatePos(${i},'h',this.value)"></td>
          <td><input type="number" step="0.0001" value="${pos.a}" oninput="updatePos(${i},'a',this.value)" onchange="updatePos(${i},'a',this.value)"></td>
          <td>
            <select onchange="updatePos(${i},'t',this.value)">
              ${[0.2, 0.5, 0.6, 0.8, 1.0, 1.2, 1.5, 2.0, 2.5, 3.0, 4.0, 5.0].map(t => 
                `<option value="${t}" ${pos.t===t?'selected':''}>${t}</option>`
              ).join('')}
            </select>
          </td>
          <td><input type="number" step="0.1" value="${pos.c}" oninput="updatePos(${i},'c',this.value)" onchange="updatePos(${i},'c',this.value)"></td>
          <td><input type="number" value="${pos.p}" oninput="updatePos(${i},'p',this.value)" onchange="updatePos(${i},'p',this.value)"></td>
          <td><input type="number" value="${pos.b}" oninput="updatePos(${i},'b',this.value)" onchange="updatePos(${i},'b',this.value)"></td>
          <td class="sum" id="pos-sum-${i}">0.00 ₽</td>
          <td><button class="del-btn" onclick="removePosition(${i})">×</button></td>
        `;
        tbody.appendChild(tr);
      });
    }

    function getBendTariff(th) {
      const b1 = parseFloat(document.getElementById('b1')?.value) || 25;
      const b2 = parseFloat(document.getElementById('b2')?.value) || 40;
      const b3 = parseFloat(document.getElementById('b3')?.value) || 70;
      const b4 = parseFloat(document.getElementById('b4')?.value) || 120;
      if (th <= 2) return b1;
      if (th <= 4) return b2;
      if (th <= 8) return b3;
      return b4;
    }

    function calcAll() {
      const density = parseFloat(document.getElementById('matDensity')?.value) || 7850;
      const pricePerKg = parseFloat(document.getElementById('matPrice')?.value) || 0;
      const cutPrice = parseFloat(document.getElementById('cutPrice')?.value) || 50;
      const pierceFee = parseFloat(document.getElementById('pierceFee')?.value) || 0.15;

      let totalWeight = 0;
      let totalMetal = 0;
      let totalCut = 0;
      let totalBend = 0;
      let totalArea = 0;

      positions.forEach((pos, i) => {
        const weight = (pos.a || 0) * (pos.q || 1) * ((pos.t || 1.5) / 1000) * density;
        const metal = weight * pricePerKg;
        const cut = ((pos.c || 0) + (pos.p || 0) * pierceFee) * (pos.q || 1) * cutPrice;
        const bend = (pos.b || 0) * (pos.q || 1) * getBendTariff(pos.t || 1.5);
        const rowSum = metal + cut + bend;

        totalWeight += weight;
        totalMetal += metal;
        totalCut += cut;
        totalBend += bend;
        totalArea += (pos.a || 0) * (pos.q || 1);

        const cell = document.getElementById(`pos-sum-${i}`);
        if (cell) cell.textContent = rowSum.toFixed(2) + ' ₽';
      });

      const paintArea = parseFloat(document.getElementById('paintArea')?.value) || 0;
      const paintPrice = parseFloat(document.getElementById('paintPrice')?.value) || 0;
      const paintSum = paintArea * paintPrice;

      const filmSide = document.getElementById('filmSide')?.value || 'none';
      const filmMult = filmSide === 'two' ? 2 : filmSide === 'one' ? 1 : 0;
      const filmSum = totalArea * filmMult * 60;

      const sandArea = parseFloat(document.getElementById('sandArea')?.value) || 0;
      const sandPrice = parseFloat(document.getElementById('sandPrice')?.value) || 0;
      const sandSum = sandArea * sandPrice;

      const weldM = parseFloat(document.getElementById('weldM')?.value) || 0;
      const weldPrice = parseFloat(document.getElementById('weldPrice')?.value) || 0;
      const otherSum = (weldM * weldPrice) +
        ((parseFloat(document.getElementById('drillCount')?.value) || 0) * 5) +
        ((parseFloat(document.getElementById('zenkCount')?.value) || 0) * 8) +
        ((parseFloat(document.getElementById('tapCount')?.value) || 0) * 30);

      const delivSum = parseFloat(document.getElementById('delivPrice')?.value) || 0;

      const subtotal = totalMetal + totalCut + totalBend + paintSum + filmSum + sandSum + otherSum + delivSum;

      const urgencyPct = parseFloat(document.getElementById('urgency')?.value) || 0;
      const urgencySum = subtotal * (urgencyPct / 100);

      let autoDisc = 0;
      if (totalWeight >= 500) autoDisc = 10;
      else if (totalWeight >= 100) autoDisc = 5;
      const manualDisc = parseFloat(document.getElementById('discount')?.value) || 0;
      const discPct = Math.max(autoDisc, manualDisc);

      const withUrgency = subtotal + urgencySum;
      const discSum = withUrgency * (discPct / 100);
      const afterDisc = withUrgency - discSum;

      const minOrder = parseFloat(document.getElementById('minOrder')?.value) || 0;
      const net = Math.max(minOrder, afterDisc);

      const vatRate = parseFloat(document.getElementById('vatRate')?.value) || 0;
      const vatSum = net * (vatRate / 100);
      const gross = net + vatSum;

      const rw = document.getElementById('res-weight'); if (rw) rw.textContent = totalWeight.toFixed(2) + ' кг';
      const rm = document.getElementById('res-metal'); if (rm) rm.textContent = totalMetal.toFixed(2) + ' ₽';
      const rc = document.getElementById('res-cut'); if (rc) rc.textContent = totalCut.toFixed(2) + ' ₽';
      const rb = document.getElementById('res-bend'); if (rb) rb.textContent = totalBend.toFixed(2) + ' ₽';

      toggleRow('row-paint', 'res-paint', paintSum, paintSum.toFixed(2) + ' ₽');
      toggleRow('row-film', 'res-film', filmSum, filmSum.toFixed(2) + ' ₽');
      toggleRow('row-sand', 'res-sand', sandSum, sandSum.toFixed(2) + ' ₽');
      toggleRow('row-other', 'res-other', otherSum, otherSum.toFixed(2) + ' ₽');
      toggleRow('row-deliv', 'res-deliv', delivSum, delivSum.toFixed(2) + ' ₽');

      const rst = document.getElementById('res-subtotal'); if (rst) rst.textContent = subtotal.toFixed(2) + ' ₽';
      toggleRow('row-urgency', 'res-urgency', urgencySum, `+${urgencySum.toFixed(2)} ₽ (${urgencyPct}%)`);
      toggleRow('row-discount', 'res-discount', discSum, `−${discSum.toFixed(2)} ₽ (${discPct}%)`);

      const rn = document.getElementById('res-net'); if (rn) rn.textContent = net.toFixed(2) + ' ₽';
      const rv = document.getElementById('res-vat'); if (rv) rv.textContent = vatSum.toFixed(2) + ' ₽';
      const rg = document.getElementById('res-gross'); if (rg) rg.textContent = gross.toFixed(2) + ' ₽';

      saveDraftToLocalStorage();
      updatePrintArea({ totalWeight, net, vatSum, gross, vatRate });
    }

    function toggleRow(rowId, textId, val, formatted) {
      const r = document.getElementById(rowId);
      const t = document.getElementById(textId);
      if (!r || !t) return;
      if (val > 0) {
        r.style.display = 'flex';
        t.textContent = formatted;
      } else {
        r.style.display = 'none';
      }
    }

    function saveQuoteLocal() {
      const quotes = JSON.parse(safeStorage.getItem('fp_offline_quotes') || '[]');
      const docNum = document.getElementById('docNum')?.value || 'КП-0001';
      const quote = {
        id: Date.now(),
        docNum,
        date: document.getElementById('docDate')?.value || '',
        customer: document.getElementById('kName')?.value || 'Без заказчика',
        gross: document.getElementById('res-gross')?.textContent || '',
        weight: document.getElementById('res-weight')?.textContent || '',
        positions: JSON.parse(JSON.stringify(positions))
      };
      quotes.unshift(quote);
      safeStorage.setItem('fp_offline_quotes', JSON.stringify(quotes.slice(0, 30)));
      renderSavedQuotesList();
      alert(`КП ${docNum} успешно сохранено!`);
    }

    function renderSavedQuotesList() {
      const container = document.getElementById('saved-quotes-list');
      if (!container) return;
      const quotes = JSON.parse(safeStorage.getItem('fp_offline_quotes') || '[]');
      if (quotes.length === 0) {
        container.innerHTML = '<span class="hint">Сохранённых расчётов пока нет.</span>';
        return;
      }
      container.innerHTML = '';
      quotes.forEach(q => {
        const item = document.createElement('div');
        item.style = 'padding:6px 8px; border:1px solid var(--brd); border-radius:6px; margin-bottom:4px; display:flex; justify-content:space-between; align-items:center;';
        item.innerHTML = `
          <div>
            <b>${q.docNum}</b> (${q.customer})<br>
            <small style="color:var(--hint)">${q.weight} · ${q.gross}</small>
          </div>
          <button class="link-btn" onclick="restoreQuote(${q.id})">Загрузить</button>
        `;
        container.appendChild(item);
      });
    }

    function restoreQuote(id) {
      const quotes = JSON.parse(safeStorage.getItem('fp_offline_quotes') || '[]');
      const q = quotes.find(x => x.id === id);
      if (!q) return;
      if (document.getElementById('docNum')) document.getElementById('docNum').value = q.docNum;
      if (document.getElementById('docDate')) document.getElementById('docDate').value = q.date;
      if (document.getElementById('kName')) document.getElementById('kName').value = q.customer;
      positions = q.positions || [];
      renderPositionsTable();
      calcAll();
      alert(`КП ${q.docNum} успешно загружено!`);
    }

    function saveDraftToLocalStorage() {
