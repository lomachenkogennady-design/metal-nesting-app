    function renderPosModal3D(pos) {
      const mount = document.getElementById('pos-modal-three-mount');
      if (!window.THREE || !mount) return;

      if (!pmThreeRenderer) {
        try {
          pmThreeScene = new THREE.Scene();
          const width = mount.clientWidth || 600;
          pmThreeCamera = new THREE.PerspectiveCamera(45, width / 350, 0.1, 100000);
          pmThreeCamera.position.set(300, 400, 500);

          pmThreeRenderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
          pmThreeRenderer.setSize(width, 350);
          pmThreeRenderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
          mount.appendChild(pmThreeRenderer.domElement);

          const l1 = new THREE.DirectionalLight(0xffffff, 0.95);
          l1.position.set(200, 400, 300);
          pmThreeScene.add(l1);
          pmThreeScene.add(new THREE.AmbientLight(0xffffff, 0.55));

          let isDragging = false, prevX = 0, prevY = 0;
          mount.addEventListener('pointerdown', (e) => { isDragging = true; prevX = e.clientX; prevY = e.clientY; });
          window.addEventListener('pointermove', (e) => {
            if (!isDragging || !pmThreeMesh) return;
            pmThreeMesh.rotation.y += (e.clientX - prevX) * 0.01;
            pmThreeMesh.rotation.x += (e.clientY - prevY) * 0.01;
            prevX = e.clientX; prevY = e.clientY;
          });
          window.addEventListener('pointerup', () => isDragging = false);

          mount.addEventListener('wheel', (e) => {
            e.preventDefault();
            zoomPosModal3D(e.deltaY > 0 ? 1.12 : 0.89);
          }, { passive: false });

          function anim() {
            pmAnimFrame = requestAnimationFrame(anim);
            if (pmSpin && pmThreeMesh && !isDragging) {
              pmThreeMesh.rotation.y += 0.005;
            }
            pmThreeCamera.lookAt(0, 0, 0);
            pmThreeRenderer.render(pmThreeScene, pmThreeCamera);
          }
          anim();
        } catch(err) {
          console.warn('WebGL init error in modal:', err);
          mount.innerHTML = '<div style="display:grid;place-items:center;height:100%;color:var(--hint);font-size:12px;text-align:center;">WebGL 3D недоступен на данном устройстве.<br>Используйте 2D чертёж изделия с размерами.</div>';
          return;
        }
      }

      if (pmThreeMesh) pmThreeScene.remove(pmThreeMesh);

      const w = pos.w, h = pos.h;
      const shape = fpBuildShape(pos.segs, pos.circles, w, h);

      const geom = new THREE.ExtrudeGeometry(shape, { depth: Math.max(0.5, pos.t), bevelEnabled: false, curveSegments: 24 });
      geom.center();

      const mat = new THREE.MeshStandardMaterial({ color: 0x90cdf4, metalness: 0.82, roughness: 0.32 });
      pmThreeMesh = new THREE.Mesh(geom, mat);
      pmThreeMesh.rotation.x = -Math.PI / 3;
      pmThreeScene.add(pmThreeMesh);

      const maxDim = Math.max(w, h, 20);
      pmIdealDist = maxDim * 1.5 + 40;
      pmThreeCamera.position.set(pmIdealDist * 0.7, pmIdealDist * 0.8, pmIdealDist);
      pmThreeCamera.near = Math.max(0.1, pmIdealDist / 200);
      pmThreeCamera.far = Math.max(10000, pmIdealDist * 50);
      pmThreeCamera.updateProjectionMatrix();
    }

    function fitPosModal3D() {
      if (!pmThreeCamera) return;
      pmThreeCamera.position.set(pmIdealDist * 0.7, pmIdealDist * 0.8, pmIdealDist);
      if (pmThreeMesh) pmThreeMesh.rotation.set(-Math.PI/3, 0, 0);
    }
    function zoomPosModal3D(factor) {
      if (!pmThreeCamera) return;
      pmThreeCamera.position.multiplyScalar(factor);
    }
    function togglePosModalSpin() {
      pmSpin = !pmSpin;
      const b = document.getElementById('btn-pm-spin'); if (b) b.textContent = pmSpin ? '⏸ Пауза вращения' : '▶ Вращение';
    }
    function togglePosModalWire() {
      if (!pmThreeMesh) return;
      pmThreeMesh.material.wireframe = !pmThreeMesh.material.wireframe;
    }
    function resetPosModalCamera(v='iso') {
      if (!pmThreeCamera || !pmThreeMesh) return;
      pmThreeMesh.rotation.set(-Math.PI/3, 0, 0);
      if (v === 'top') pmThreeCamera.position.set(0, pmIdealDist * 1.4, 0.001);
      else pmThreeCamera.position.set(pmIdealDist * 0.7, pmIdealDist * 0.8, pmIdealDist);
    }

    /* Интерактивная гибка прямо внутри модалки позиции */
    function applyModalBendPreset(angles) {
      const pos = positions[modalPosIndex];
      if (!pos) return;
      const step = pos.w / (angles.length + 1);
      pos.bends = angles.map((ang, i) => ({
        pos: Math.round(step * (i + 1)),
        angle: ang,
        r: pos.t || 1.5
      }));
      pos.b = pos.bends.length;
      updatePos(modalPosIndex, 'b', pos.b);
      renderPosModalBend(pos);
      const btn = document.getElementById('pos-modal-btn-bend');
      if (btn) btn.textContent = `Гибка (${pos.b})`;
    }

    function addModalBend() {
      const pos = positions[modalPosIndex];
      if (!pos) return;
      if (!pos.bends) pos.bends = [];
      const count = pos.bends.length + 1;
      const step = pos.w / (count + 1);
      pos.bends.push({ pos: Math.round(step * count), angle: 90, r: pos.t || 1.5 });
      pos.b = pos.bends.length;
      updatePos(modalPosIndex, 'b', pos.b);
      renderPosModalBend(pos);
      const btn = document.getElementById('pos-modal-btn-bend');
      if (btn) btn.textContent = `Гибка (${pos.b})`;
    }

    function clearModalBends() {
      const pos = positions[modalPosIndex];
      if (!pos) return;
      pos.bends = [];
      pos.b = 0;
      updatePos(modalPosIndex, 'b', 0);
      renderPosModalBend(pos);
      const btn = document.getElementById('pos-modal-btn-bend');
      if (btn) btn.textContent = 'Гибка';
    }

    function renderPosModalBend(pos) {
      const sFlat = document.getElementById('pos-modal-bend-flat');
      const sProf = document.getElementById('pos-modal-bend-profile');
      const noticesBox = document.getElementById('pos-modal-bend-notices');
      if (!sFlat || !sProf) return;

      if (!pos.bends || pos.bends.length === 0) {
        if (noticesBox) noticesBox.innerHTML = '<div class="hint" style="padding:10px;text-align:center;">Гибы пока не заданы. Нажмите пресет выше («Уголок 90°», «П-профиль») или «+ Добавить гиб».</div>';
        sFlat.innerHTML = '';
        sProf.innerHTML = '';
        return;
      }

      let notices = [];
      pos.bends.forEach((b, i) => {
        const left = b.pos || b.position || 0;
        const right = pos.w - left;
        if (Math.min(left, right) < 11) notices.push(`<div class="notice-item warning">⚠️ Гиб #${i+1}: полка ${Math.min(left,right)} мм меньше мин. борта (11 мм по Памятке).</div>`);
      });
      if (noticesBox) noticesBox.innerHTML = notices.join('');

      const W = 760, H = 220, PAD = 40;
      const scale = Math.min((W - PAD*2)/pos.w, (H - PAD*2)/pos.h);
      let fContent = `<rect width="${W}" height="${H}" fill="#ffffff"/><g transform="translate(${(W-pos.w*scale)/2}, ${(H-pos.h*scale)/2})">`;
      fContent += `<rect width="${pos.w*scale}" height="${pos.h*scale}" fill="#f2f6fb" stroke="#1a365d" stroke-width="2"/>`;

      pos.bends.forEach((b) => {
        const x = (b.pos || b.position || 0) * scale;
        fContent += `
          <line x1="${x}" y1="-5" x2="${x}" y2="${pos.h*scale+5}" stroke="#c05621" stroke-width="1.8" stroke-dasharray="6,4"/>
          <text x="${x}" y="-8" text-anchor="middle" fill="#c05621" font-size="10" font-weight="bold">${b.angle>0?'▲':'▼'} ${b.angle}° (L=${(b.pos||b.position)}мм)</text>
        `;
      });
      fContent += `</g>`;
      sFlat.innerHTML = fContent;

      let pContent = `<rect width="${W}" height="200" fill="#ffffff"/><g transform="translate(60, 100)">`;
      let curX = 0, curY = 0, curAngle = 0;
      let lastPos = 0;
      let pathD = `M 0 0`;
      pos.bends.forEach(b => {
        const bPos = b.pos || b.position || 0;
        const len = (bPos - lastPos) * 0.4;
        curX += len * Math.cos(curAngle);
        curY += len * Math.sin(curAngle);
        pathD += ` L ${curX} ${curY}`;
        curAngle += (b.angle * Math.PI) / 180;
        lastPos = bPos;
      });
      const tail = (pos.w - lastPos) * 0.4;
      curX += tail * Math.cos(curAngle);
      curY += tail * Math.sin(curAngle);
      pathD += ` L ${curX} ${curY}`;

      pContent += `<path d="${pathD}" fill="none" stroke="#2b6cb0" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/>`;
      pContent += `<text x="10" y="70" fill="#718096" font-size="11">Профиль детали после гибки (сечение)</text></g>`;
      sProf.innerHTML = pContent;
    }

    /* ---------------- 3. Конструктор DXF / 2D / 3D / Раскрой ---------------- */
    function syncPositionsToDesigner() {
      if (positions.length === 0) return;
      designerParts = positions.map((p, idx) => ({
        id: p.id || ('dp_' + idx),
        name: p.name || `Деталь ${idx + 1}`,
        w: p.w || 400,
        h: p.h || 300,
        count: Math.max(1, p.q || 1),
        cut: p.c || ((p.w * 2 + p.h * 2) / 1000),
        area: p.a || ((p.w * p.h) / 1e6),
        segs: p.segs || [
          { x1: 0, y1: 0, x2: p.w, y2: 0 },
          { x1: p.w, y1: 0, x2: p.w, y2: p.h },
          { x1: p.w, y1: p.h, x2: 0, y2: p.h },
          { x1: 0, y1: p.h, x2: 0, y2: 0 }
        ],
        circles: p.circles || [],
        bends: p.bends || []
      }));
      renderPartsList();
    }

    function switchDesignView(view) {
      currentDesignView = view;
      ['2d', 'bend', '3d'].forEach(v => {
        const el = document.getElementById(`view-${v}`);
        const btn = document.getElementById(`btn-v-${v}`);
        if (el) el.style.display = v === view ? 'block' : 'none';
        if (btn) btn.classList.toggle('active', v === view);
      });
      renderCurrentPartView();
    }

    function generateShapeUI() {
      const kind = document.getElementById('genKind')?.value || 'rect';
      const w = parseFloat(document.getElementById('genW')?.value) || 400;
      const h = parseFloat(document.getElementById('genH')?.value) || 300;
      const r = parseFloat(document.getElementById('genR')?.value) || 20;

      let segs = [], circles = [];
      if (kind === 'rect') {
        segs = [{x1:0,y1:0,x2:w,y2:0},{x1:w,y1:0,x2:w,y2:h},{x1:w,y1:h,x2:0,y2:h},{x1:0,y1:h,x2:0,y2:0}];
      } else if (kind === 'disc') {
        circles = [{cx: w/2, cy: w/2, r: w/2}];
      } else if (kind === 'ring') {
        circles = [{cx: w/2, cy: w/2, r: w/2}, {cx: w/2, cy: w/2, r: r}];
      } else if (kind === 'plateHoles') {
        segs = [{x1:0,y1:0,x2:w,y2:0},{x1:w,y1:0,x2:w,y2:h},{x1:w,y1:h,x2:0,y2:h},{x1:0,y1:h,x2:0,y2:0}];
        const pad = Math.min(30, Math.min(w,h)/4);
        circles = [
          {cx: pad, cy: pad, r: r/2},
          {cx: w - pad, cy: pad, r: r/2},
          {cx: w - pad, cy: h - pad, r: r/2},
          {cx: pad, cy: h - pad, r: r/2}
        ];
      } else if (kind === 'lBracket') {
        const leg = 80;
        segs = [
          {x1:0,y1:0,x2:w,y2:0},{x1:w,y1:0,x2:w,y2:leg},
          {x1:w,y1:leg,x2:leg,y2:leg},{x1:leg,y1:leg,x2:leg,y2:h},
          {x1:leg,y1:h,x2:0,y2:h},{x1:0,y1:h,x2:0,y2:0}
        ];
      } else { // roundRect
        segs = [{x1:0,y1:0,x2:w,y2:0},{x1:w,y1:0,x2:w,y2:h},{x1:w,y1:h,x2:0,y2:h},{x1:0,y1:h,x2:0,y2:0}];
      }

      const sel = document.getElementById('genKind');
      const label = sel ? sel.options[sel.selectedIndex]?.text : 'Прямоугольник';
      window._currentGenerated = { name: label, w, h, segs, circles };
      render2DPreview(window._currentGenerated);
    }

    function addCurrentShapeToParts() {
      if (!window._currentGenerated) return;
      const g = window._currentGenerated;
      const cut = (g.w * 2 + g.h * 2) / 1000;
      designerParts.push({
        id: 'dp_' + Date.now(),
        name: g.name,
        w: g.w,
        h: g.h,
        count: 1,
        cut,
        area: Number(((g.w*g.h)/1e6).toFixed(4)),
        segs: g.segs,
        circles: g.circles,
        bends: []
      });
      activePartIndex = designerParts.length - 1;
      renderPartsList();
      renderCurrentPartView();
    }

    function handleDXFFiles(e) {
      const files = e.target.files;
      if (!files || files.length === 0) return;
      Array.from(files).forEach(f => {
        const reader = new FileReader();
        reader.onload = () => {
          const parsed = parseDXFString(reader.result);
          designerParts.push({
            id: 'dxf_' + Date.now() + '_' + Math.random().toString(36).substr(2,3),
            name: f.name.replace(/\.dxf$/i,''),
            w: Math.round(parsed.w),
            h: Math.round(parsed.h),
            count: 1,
            cut: Number(parsed.cut.toFixed(2)),
            area: Number(parsed.area.toFixed(4)),
            segs: parsed.segs,
            circles: parsed.circles,
            bends: [],
            isCustomDxf: true
          });
          activePartIndex = designerParts.length - 1;
          renderPartsList();
          renderCurrentPartView();
        };
        reader.readAsText(f);
      });
    }

    function parseDXFString(txt) {
      const L = txt.split(/\r?\n/);
      let segs = [], circles = [], arcs = [];
      let c = null, i = 0;
      while (i < L.length - 1) {
        const code = L[i].trim(), val = L[i+1].trim();
        i += 2;
        if (code === '0') {
          if (c) {
            if (c.type === 'line') segs.push({ x1: c.x1, y1: c.y1, x2: c.x2, y2: c.y2 });
            else if (c.type === 'poly') {
              for (let k = 0; k < c.pts.length - 1; k++) {
                segs.push({ x1: c.pts[k][0], y1: c.pts[k][1], x2: c.pts[k+1][0], y2: c.pts[k+1][1] });
              }
              if (c.closed && c.pts.length > 2) {
                segs.push({ x1: c.pts[c.pts.length-1][0], y1: c.pts[c.pts.length-1][1], x2: c.pts[0][0], y2: c.pts[0][1] });
              }
            } else if (c.type === 'circle') circles.push({ cx: c.cx, cy: c.cy, r: c.r });
            else if (c.type === 'arc') arcs.push({ cx: c.cx, cy: c.cy, r: c.r, a1: c.a1, a2: c.a2 });
          }
          if (val === 'LINE') c = { type: 'line', x1: 0, y1: 0, x2: 0, y2: 0 };
          else if (val === 'LWPOLYLINE' || val === 'POLYLINE') c = { type: 'poly', pts: [], closed: false, tx: 0 };
          else if (val === 'CIRCLE') c = { type: 'circle', cx: 0, cy: 0, r: 0 };
          else if (val === 'ARC') c = { type: 'arc', cx: 0, cy: 0, r: 0, a1: 0, a2: 0 };
          else c = null;
          continue;
        }
        if (!c) continue;
        const f = parseFloat(val);
        if (c.type === 'line') {
          if (code==='10') c.x1=f; if (code==='20') c.y1=f;
          if (code==='11') c.x2=f; if (code==='21') c.y2=f;
        } else if (c.type === 'poly') {
          if (code==='10') c.tx = f;
          if (code==='20') c.pts.push([c.tx, f]);
          if (code==='70') c.closed = (parseInt(val, 10) & 1) === 1;
        } else if (c.type === 'circle') {
          if (code==='10') c.cx=f; if (code==='20') c.cy=f; if (code==='40') c.r=f;
        } else if (c.type === 'arc') {
          if (code==='10') c.cx=f; if (code==='20') c.cy=f; if (code==='40') c.r=f;
          if (code==='50') c.a1=f; if (code==='51') c.a2=f;
        }
      }
      if (c) {
        if (c.type === 'line') segs.push({ x1: c.x1, y1: c.y1, x2: c.x2, y2: c.y2 });
        else if (c.type === 'poly') {
          for (let k = 0; k < c.pts.length - 1; k++) {
            segs.push({ x1: c.pts[k][0], y1: c.pts[k][1], x2: c.pts[k+1][0], y2: c.pts[k+1][1] });
          }
          if (c.closed && c.pts.length > 2) {
            segs.push({ x1: c.pts[c.pts.length-1][0], y1: c.pts[c.pts.length-1][1], x2: c.pts[0][0], y2: c.pts[0][1] });
          }
        } else if (c.type === 'circle') circles.push({ cx: c.cx, cy: c.cy, r: c.r });
        else if (c.type === 'arc') arcs.push({ cx: c.cx, cy: c.cy, r: c.r, a1: c.a1, a2: c.a2 });
      }

      arcs.forEach(a => {
        let sw = a.a2 - a.a1;
        if (sw < 0) sw += 360;
        const steps = Math.max(6, Math.ceil((sw / 360) * 16));
        const a1Rad = (a.a1 * Math.PI) / 180;
        let px = a.cx + a.r * Math.cos(a1Rad);
        let py = a.cy + a.r * Math.sin(a1Rad);
        for (let s = 1; s <= steps; s++) {
          const ang = a1Rad + ((sw * Math.PI) / 180) * (s / steps);
          const nx = a.cx + a.r * Math.cos(ang);
          const ny = a.cy + a.r * Math.sin(ang);
          segs.push({ x1: px, y1: py, x2: nx, y2: ny });
          px = nx; py = ny;
        }
      });

      let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity, cutLen = 0;
      segs.forEach(s => {
        cutLen += Math.hypot(s.x2 - s.x1, s.y2 - s.y1);
        minX = Math.min(minX, s.x1, s.x2); maxX = Math.max(maxX, s.x1, s.x2);
        minY = Math.min(minY, s.y1, s.y2); maxY = Math.max(maxY, s.y1, s.y2);
      });
      circles.forEach(c => {
        cutLen += 2 * Math.PI * c.r;
        minX = Math.min(minX, c.cx - c.r); maxX = Math.max(maxX, c.cx + c.r);
        minY = Math.min(minY, c.cy - c.r); maxY = Math.max(maxY, c.cy + c.r);
      });

      if (!isFinite(minX)) { minX = minY = 0; maxX = maxY = 100; }
      const w = Math.max(5, maxX - minX);
      const h = Math.max(5, maxY - minY);

      const normSegs = segs.map(s => ({
        x1: s.x1 - minX, y1: s.y1 - minY,
        x2: s.x2 - minX, y2: s.y2 - minY
      }));
      const normCircles = circles.map(c => ({
        cx: c.cx - minX, cy: c.cy - minY, r: c.r
      }));

      return { segs: normSegs, circles: normCircles, w, h, cut: cutLen / 1000, area: (w * h) / 1e6 };
    }

    function renderPartsList() {
      const container = document.getElementById('parts-list');
      const countEl = document.getElementById('parts-count');
      if (countEl) countEl.textContent = designerParts.length;
      if (!container) return;
      container.innerHTML = '';
      designerParts.forEach((p, idx) => {
        const item = document.createElement('div');
        item.style = `padding:8px 10px; border:1px solid ${idx===activePartIndex?'var(--acc)':'var(--brd)'}; border-radius:8px; display:flex; justify-content:space-between; align-items:center; cursor:pointer; background:${idx===activePartIndex?'var(--acc-light)':'transparent'};`;
        item.onclick = (e) => {
          if (e.target.tagName !== 'BUTTON' && e.target.tagName !== 'INPUT') {
            activePartIndex = idx;
            fitDrawing2D();
            renderPartsList();
            renderCurrentPartView();
          }
        };
        item.innerHTML = `
          <div>
            <b>${p.name}</b><br>
            <small style="color:var(--hint)">${p.w}×${p.h} мм · ${p.bends&&p.bends.length>0?p.bends.length+' гибов':'плоская'}</small>
          </div>
          <div style="display:flex; align-items:center; gap:6px;">
            <input type="number" min="1" value="${p.count}" style="width:45px; height:26px;" onclick="event.stopPropagation()" onchange="designerParts[${idx}].count=parseInt(this.value)||1">
            <button class="del-btn" onclick="event.stopPropagation(); removePart(${idx})">×</button>
          </div>
        `;
        container.appendChild(item);
      });
    }

    function removePart(idx) {
      designerParts.splice(idx, 1);
      activePartIndex = Math.max(0, activePartIndex - 1);
      fitDrawing2D();
      renderPartsList();
      renderCurrentPartView();
    }

    function clearParts() {
      designerParts = [];
      activePartIndex = 0;
      fitDrawing2D();
      renderPartsList();
      renderCurrentPartView();
    }

    function renderCurrentPartView() {
      init2DInteraction();
      const part = designerParts[activePartIndex] || window._currentGenerated;
      if (!part) return;
      const title = document.getElementById('part-title');
      if (title) title.textContent = part.name;

      const noticesBox = document.getElementById('part-notices');
      if (noticesBox) {
        let notices = [];
        if (part.w > 2990 || part.h > 1490) notices.push('<div class="notice-item error">⛔ Деталь превышает рабочее поле лазера (2990 × 1490 мм).</div>');
        else if (part.w > 2490 || part.h > 1240) notices.push('<div class="notice-item warning">⚠️ Деталь больше стандартного раскроя 2490 × 1240 мм.</div>');
        if (part.bends && part.bends.length > 0) {
          if (part.h > 2490) notices.push('<div class="notice-item error">⛔ Ширина гиба превышает лимит пресса (2490 мм).</div>');
        }
        noticesBox.innerHTML = notices.join('');
      }

      if (currentDesignView === '2d') {
        render2DPreview(part);
      } else if (currentDesignView === 'bend') {
        renderBendUI(part);
      } else if (currentDesignView === '3d') {
        update3DModel(part);
      }
    }

    function render2DPreview(part) {
      const svg = document.getElementById('svg-drawing');
      if (!svg) return;
      const W = 760, H = 400;
      const padLeft = 70, padRight = 35, padBottom = 55, padTop = 45;
      const availW = W - padLeft - padRight;
      const availH = H - padTop - padBottom;

      const baseScale = Math.min(availW / Math.max(1, part.w), availH / Math.max(1, part.h));
      const scale = baseScale * zoom2D;

      const lbl = document.getElementById('zoom2d-label');
      if (lbl) lbl.textContent = Math.round(zoom2D * 100) + '%';

      let content = `<rect width="${W}" height="${H}" fill="#ffffff"/>`;
      content += `<defs><pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse"><path d="M 20 0 L 0 0 0 20" fill="none" stroke="#f0f3f8" stroke-width="1"/></pattern></defs><rect width="${W}" height="${H}" fill="url(#grid)"/>`;

      const centerX = padLeft + availW / 2 + pan2D.x;
      const centerY = padTop + availH / 2 + pan2D.y;

      const ox = centerX - (part.w * scale) / 2;
      const oy = centerY - (part.h * scale) / 2;

      // Оси симметрии детали
      content += `<g stroke="#cbd5e0" stroke-width="0.8" stroke-dasharray="8 4 2 4">
        <line x1="${centerX}" y1="${oy - 18}" x2="${centerX}" y2="${oy + part.h*scale + 18}" />
        <line x1="${ox - 18}" y1="${centerY}" x2="${ox + part.w*scale + 18}" y2="${centerY}" />
      </g>`;

      // Контуры и отрезки детали
      content += `<g stroke="#1a365d" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">`;
      if (part.segs && part.segs.length > 0) {
        part.segs.forEach(s => {
          content += `<line x1="${ox + s.x1*scale}" y1="${oy + s.y1*scale}" x2="${ox + s.x2*scale}" y2="${oy + s.y2*scale}"/>`;
        });
      } else {
        content += `<rect x="${ox}" y="${oy}" width="${part.w*scale}" height="${part.h*scale}" fill="rgba(49,130,206,0.15)"/>`;
      }
      content += `</g>`;

      // Отверстия
      if (part.circles && part.circles.length > 0) {
        content += `<g stroke="#c05621" stroke-width="1.6" fill="none">`;
        part.circles.forEach(c => {
          const cx = ox + c.cx * scale;
          const cy = oy + c.cy * scale;
          const r = Math.max(1, c.r * scale);
          content += `<circle cx="${cx}" cy="${cy}" r="${r}" fill="#ffffff"/>`;
          content += `<line x1="${cx - r - 4}" y1="${cy}" x2="${cx + r + 4}" y2="${cy}" stroke="#c05621" stroke-dasharray="4,2" stroke-width="0.8"/>`;
          content += `<line x1="${cx}" y1="${cy - r - 4}" x2="${cx}" y2="${cy + r + 4}" stroke="#c05621" stroke-dasharray="4,2" stroke-width="0.8"/>`;
        });
        content += `</g>`;
      }

      // Размерные линии (ширина и высота)
      const x0 = ox, x1 = ox + part.w * scale;
      const y0 = oy + part.h * scale, y1 = oy;

      content += `<g stroke="#2b6cb0" stroke-width="1" fill="#2b6cb0" font-size="11" font-family="sans-serif">
        <line x1="${x0}" y1="${y0 + 16}" x2="${x1}" y2="${y0 + 16}"/>
        <line x1="${x0}" y1="${y0 + 10}" x2="${x0}" y2="${y0 + 22}"/>
        <line x1="${x1}" y1="${y0 + 10}" x2="${x1}" y2="${y0 + 22}"/>
        <text x="${(x0 + x1)/2}" y="${y0 + 30}" text-anchor="middle" font-weight="600" stroke="none">${part.w} мм</text>

        <line x1="${x0 - 16}" y1="${y0}" x2="${x0 - 16}" y2="${y1}"/>
        <line x1="${x0 - 22}" y1="${y0}" x2="${x0 - 10}" y2="${y0}"/>
        <line x1="${x0 - 22}" y1="${y1}" x2="${x0 - 10}" y2="${y1}"/>
        <text x="${x0 - 24}" y="${(y0 + y1)/2}" text-anchor="middle" font-weight="600" stroke="none" transform="rotate(-90 ${x0 - 24} ${(y0 + y1)/2})">${part.h} мм</text>
      </g>`;

      content += `<g font-family="sans-serif" fill="#4a5568">
        <text x="20" y="24" font-size="13" font-weight="700" fill="#1a365d">${part.name || 'Деталь'}</text>
        <text x="20" y="38" font-size="10" fill="#718096">Масштаб 1:${Math.max(1, Math.round(1/scale))} · Окно: ${Math.round(zoom2D*100)}%</text>
      </g>`;

      svg.innerHTML = content;
    }

    function init2DInteraction() {
      const wrap = document.getElementById('svg-drawing-wrap');
      if (!wrap || wrap._inited) return;
      wrap._inited = true;

      wrap.addEventListener('pointerdown', (e) => {
        isDragging2D = true;
        startPtr2D = { x: e.clientX, y: e.clientY };
        wrap.setPointerCapture(e.pointerId);
        wrap.style.cursor = 'grabbing';
      });

      wrap.addEventListener('pointermove', (e) => {
        if (!isDragging2D) return;
        const dx = e.clientX - startPtr2D.x;
        const dy = e.clientY - startPtr2D.y;
        startPtr2D = { x: e.clientX, y: e.clientY };
        pan2D.x += dx;
        pan2D.y += dy;
        const part = designerParts[activePartIndex] || window._currentGenerated;
        if (part) render2DPreview(part);
      });

      const stopDrag = () => {
        isDragging2D = false;
        if (wrap) wrap.style.cursor = 'grab';
      };
      wrap.addEventListener('pointerup', stopDrag);
      wrap.addEventListener('pointercancel', stopDrag);

      wrap.addEventListener('wheel', (e) => {
        e.preventDefault();
        const factor = e.deltaY < 0 ? 1.15 : 0.87;
        zoom2D = Math.max(0.15, Math.min(12, zoom2D * factor));
        const part = designerParts[activePartIndex] || window._currentGenerated;
        if (part) render2DPreview(part);
      }, { passive: false });
    }

    function fitDrawing2D() {
      zoom2D = 1;
      pan2D = { x: 0, y: 0 };
      const part = designerParts[activePartIndex] || window._currentGenerated;
      if (part) render2DPreview(part);
    }
    function zoomDrawing2D(factor) {
      zoom2D = Math.max(0.15, Math.min(12, zoom2D * factor));
      const part = designerParts[activePartIndex] || window._currentGenerated;
      if (part) render2DPreview(part);
    }
    function resetZoom2D(z) {
      zoom2D = z || 1;
      pan2D = { x: 0, y: 0 };
      const part = designerParts[activePartIndex] || window._currentGenerated;
      if (part) render2DPreview(part);
    }

    function exportDrawingSVG() {
      const svg = document.getElementById('svg-drawing')?.outerHTML;
      if (!svg) return;
      const blob = new Blob([svg], { type: 'image/svg+xml' });
      const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'drawing.svg'; a.click();
    }
    function exportDrawingPNG() {
      const svg = document.getElementById('svg-drawing');
      if (!svg) return;
      const xml = new XMLSerializer().serializeToString(svg);
      const img = new Image();
      img.src = 'data:image/svg+xml;base64,' + btoa(unescape(encodeURIComponent(xml)));
      img.onload = () => {
        const c = document.createElement('canvas'); c.width = 1520; c.height = 800;
        const ctx = c.getContext('2d'); ctx.fillStyle = '#fff'; ctx.fillRect(0,0,c.width,c.height);
        ctx.drawImage(img, 0, 0, c.width, c.height);
        const a = document.createElement('a'); a.href = c.toDataURL('image/png'); a.download = 'drawing.png'; a.click();
      };
    }

    /* ---------------- Гибка ---------------- */
    function applyBendPreset(angles) {
      const p = designerParts[activePartIndex];
      if (!p) return;
      const step = p.w / (angles.length + 1);
      p.bends = angles.map((ang, i) => ({ pos: Math.round(step * (i+1)), angle: ang, r: 1.5 }));
      renderPartsList();
      renderBendUI(p);
      calcAll();
    }

    function addCustomBend() {
      const p = designerParts[activePartIndex];
      if (!p) return;
      if (!p.bends) p.bends = [];
      const count = p.bends.length + 1;
      const step = p.w / (count + 1);
      p.bends.push({ pos: Math.round(step * count), angle: 90, r: 1.5 });
      renderPartsList();
      renderBendUI(p);
      calcAll();
    }

    function renderBendUI(part) {
      if (!part.bends) part.bends = [];
      const noticesBox = document.getElementById('bend-notices');
      let notices = [];
      part.bends.forEach((b, i) => {
        const left = b.pos, right = part.w - b.pos;
        if (Math.min(left, right) < 11) notices.push(`<div class="notice-item warning">⚠️ Гиб #${i+1}: полка ${Math.min(left,right)} мм меньше мин. борта (11 мм по Памятке).</div>`);
      });
      if (noticesBox) noticesBox.innerHTML = notices.join('');

      const sFlat = document.getElementById('svg-bend-flat');
      const sProf = document.getElementById('svg-bend-profile');
      if (!sFlat || !sProf) return;

      const W = 760, H = 220, PAD = 40;
      const scale = Math.min((W - PAD*2)/part.w, (H - PAD*2)/part.h);
      let fContent = `<rect width="${W}" height="${H}" fill="#ffffff"/><g transform="translate(${(W-part.w*scale)/2}, ${(H-part.h*scale)/2})">`;
      fContent += `<rect width="${part.w*scale}" height="${part.h*scale}" fill="#f2f6fb" stroke="#1a365d" stroke-width="2"/>`;

      part.bends.forEach((b) => {
        const x = b.pos * scale;
        fContent += `
          <line x1="${x}" y1="-5" x2="${x}" y2="${part.h*scale+5}" stroke="#c05621" stroke-width="1.8" stroke-dasharray="6,4"/>
          <text x="${x}" y="-8" text-anchor="middle" fill="#c05621" font-size="10" font-weight="bold">${b.angle>0?'▲':'▼'} ${b.angle}° (L=${b.pos}мм)</text>
        `;
      });
      fContent += `</g>`;
      sFlat.innerHTML = fContent;

      let pContent = `<rect width="${W}" height="${H}" fill="#ffffff"/><g transform="translate(60, 100)">`;
      let curX = 0, curY = 0, curAngle = 0;
      let lastPos = 0;
      let pathD = `M 0 0`;
      part.bends.forEach(b => {
        const len = (b.pos - lastPos) * 0.4;
        curX += len * Math.cos(curAngle);
        curY += len * Math.sin(curAngle);
        pathD += ` L ${curX} ${curY}`;
        curAngle += (b.angle * Math.PI) / 180;
        lastPos = b.pos;
      });
      const tail = (part.w - lastPos) * 0.4;
      curX += tail * Math.cos(curAngle);
      curY += tail * Math.sin(curAngle);
      pathD += ` L ${curX} ${curY}`;

      pContent += `<path d="${pathD}" fill="none" stroke="#2b6cb0" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/>`;
      pContent += `<text x="10" y="70" fill="#718096" font-size="11">Профиль детали после гибки (сечение)</text></g>`;
      sProf.innerHTML = pContent;
    }

    function recalcBendingUI() {
      const p = designerParts[activePartIndex];
      if (p) renderBendUI(p);
    }

    /* ---------------- 3D Просмотр (Three.js WebGL) ---------------- */
    function initThreeJS() {
      const mount = document.getElementById('three-mount');
      if (!window.THREE || !mount || threeRenderer) return;

      try {
        threeScene = new THREE.Scene();
        const width = mount.clientWidth || 600;
        threeCamera = new THREE.PerspectiveCamera(45, width / 350, 0.1, 100000);
        threeCamera.position.set(300, 400, 500);

        threeRenderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        threeRenderer.setSize(width, 350);
        threeRenderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
        mount.appendChild(threeRenderer.domElement);

        const light1 = new THREE.DirectionalLight(0xffffff, 0.95);
        light1.position.set(200, 400, 300);
        threeScene.add(light1);
        threeScene.add(new THREE.AmbientLight(0xffffff, 0.55));

        let isDragging = false, prevX = 0, prevY = 0;
        mount.addEventListener('pointerdown', (e) => { isDragging = true; prevX = e.clientX; prevY = e.clientY; });
        window.addEventListener('pointermove', (e) => {
          if (!isDragging || !threeMesh) return;
          const dx = e.clientX - prevX; const dy = e.clientY - prevY;
          threeMesh.rotation.y += dx * 0.01;
          threeMesh.rotation.x += dy * 0.01;
          prevX = e.clientX; prevY = e.clientY;
        });
        window.addEventListener('pointerup', () => isDragging = false);

        mount.addEventListener('wheel', (e) => {
          e.preventDefault();
          const factor = e.deltaY > 0 ? 1.12 : 0.89;
          zoom3D(factor);
        }, { passive: false });

        function anim() {
          threeAnimFrame = requestAnimationFrame(anim);
          if (threeSpin && threeMesh && !isDragging) {
            threeMesh.rotation.y += 0.005;
          }
          threeCamera.lookAt(0, 0, 0);
          threeRenderer.render(threeScene, threeCamera);
        }
        anim();
      } catch(err) {
        console.warn('WebGL init error:', err);
        mount.innerHTML = '<div style="display:grid;place-items:center;height:100%;color:var(--hint);font-size:12px;text-align:center;">WebGL 3D недоступен на данном устройстве.<br>Используйте 2D чертёж изделия с размерами.</div>';
      }
    }

    function update3DModel(part) {
      if (!window.THREE) return;
      if (!threeScene) initThreeJS();
      if (!threeScene) return;
      if (threeMesh) threeScene.remove(threeMesh);

      const w = part.w, h = part.h;
      const shape = fpBuildShape(part.segs, part.circles, w, h);

      const geom = new THREE.ExtrudeGeometry(shape, { depth: 3, bevelEnabled: false, curveSegments: 24 });
      geom.center();

      const mat = new THREE.MeshStandardMaterial({ color: 0x90cdf4, metalness: 0.82, roughness: 0.32 });
      threeMesh = new THREE.Mesh(geom, mat);
      threeMesh.rotation.x = -Math.PI / 3;
      threeScene.add(threeMesh);

      const maxDim = Math.max(w, h, 20);
      idealDist3D = maxDim * 1.5 + 40;
      threeCamera.position.set(idealDist3D * 0.7, idealDist3D * 0.8, idealDist3D);
      threeCamera.near = Math.max(0.1, idealDist3D / 200);
      threeCamera.far = Math.max(10000, idealDist3D * 50);
      threeCamera.updateProjectionMatrix();
    }

    function fit3DCamera() {
      if (!threeCamera) return;
      threeCamera.position.set(idealDist3D * 0.7, idealDist3D * 0.8, idealDist3D);
      if (threeMesh) threeMesh.rotation.set(-Math.PI/3, 0, 0);
    }
    function zoom3D(factor) {
      if (!threeCamera) return;
      threeCamera.position.multiplyScalar(factor);
    }
    function toggle3DSpin() {
      threeSpin = !threeSpin;
      const b = document.getElementById('btn-3d-spin'); if (b) b.textContent = threeSpin ? '⏸ Пауза вращения' : '▶ Вращение';
    }
    function toggle3DWireframe() {
      if (!threeMesh) return;
      threeMesh.material.wireframe = !threeMesh.material.wireframe;
    }
    function reset3DCamera(view='iso') {
      if (!threeCamera || !threeMesh) return;
      threeMesh.rotation.set(-Math.PI/3, 0, 0);
      if (view === 'top') {
        threeCamera.position.set(0, idealDist3D * 1.4, 0.001);
      } else {
        threeCamera.position.set(idealDist3D * 0.7, idealDist3D * 0.8, idealDist3D);
      }
    }

    /* ---------------- 4. Раскрой MaxRects ---------------- */
    function runNestingUI() {
      if (designerParts.length === 0 && positions.length > 0) {
        syncPositionsToDesigner();
      }

      const sel = (document.getElementById('nestSheetSelect')?.value || '2500x1250').split('x');
      const sheetW = parseInt(sel[0]), sheetH = parseInt(sel[1]);
      const margin = parseInt(document.getElementById('nestMargin')?.value) || 5;
      const kerf = parseInt(document.getElementById('nestKerf')?.value) || 2;
      const allowRot = document.getElementById('nestRotate')?.checked !== false;

      const items = [];
      designerParts.forEach((p) => {
        for (let i = 0; i < (p.count || 1); i++) {
          items.push({ id: p.id, name: p.name, w: (p.w || 400) + kerf, h: (p.h || 300) + kerf, rawW: p.w, rawH: p.h, segs: p.segs, circles: p.circles });
        }
      });

      if (items.length === 0) {
        alert('Список деталей пуст! Добавьте позиции в калькулятор или создайте деталь.');
        return;
      }

      items.sort((a,b) => (b.w * b.h) - (a.w * a.h));
      const maxW = sheetW - margin * 2;
      const maxH = sheetH - margin * 2;

      let sheets = [];
      let curSheet = { placements: [], usedArea: 0 };
      sheets.push(curSheet);

      let curX = margin, curY = margin, rowH = 0;
      items.forEach(it => {
        let pw = it.w, ph = it.h;
        let isRot = false;
        if (allowRot && (curX + pw > sheetW - margin) && (curX + ph <= sheetW - margin)) {
          pw = it.h; ph = it.w; isRot = true;
        }
        if (curX + pw > sheetW - margin) {
          curX = margin; curY += rowH + kerf; rowH = 0;
        }
        if (curY + ph > sheetH - margin) {
          curSheet = { placements: [], usedArea: 0 };
          sheets.push(curSheet);
          curX = margin; curY = margin; rowH = 0;
        }
        curSheet.placements.push({ name: it.name, x: curX, y: curY, w: pw - kerf, h: ph - kerf, isRot, segs: it.segs, circles: it.circles, rawW: it.rawW, rawH: it.rawH });
        curSheet.usedArea += (pw - kerf) * (ph - kerf);
        curX += pw + kerf;
        rowH = Math.max(rowH, ph);
      });

      renderNestResults(sheets, sheetW, sheetH);
    }

    function renderNestResults(sheets, sheetW, sheetH) {
      const cont = document.getElementById('nest-sheets-container');
      const sumBox = document.getElementById('nest-summary');
      if (!cont || !sumBox) return;
      cont.innerHTML = '';
      sumBox.style.display = 'grid';

      let totalUsed = 0;
      sheets.forEach((s, idx) => {
        totalUsed += s.usedArea;
        const card = document.createElement('div');
        card.className = 'sheet-card';
        const usagePct = ((s.usedArea / (sheetW * sheetH)) * 100).toFixed(1);

        let svgItems = '';
        s.placements.forEach(p => {
          svgItems += `
            <g>
              <rect x="${p.x}" y="${p.y}" width="${p.w}" height="${p.h}" fill="rgba(49,130,206,0.22)" stroke="#2b6cb0" stroke-width="3" rx="2"/>
              <text x="${p.x + p.w/2}" y="${p.y + p.h/2}" font-size="${Math.max(12, Math.min(p.h/3.5, 24))}" fill="#1a202c" font-weight="600" text-anchor="middle" dominant-baseline="middle">${p.name}${p.isRot?' ↻':''}</text>
            </g>
          `;
        });

        card.innerHTML = `
          <header>
            <span>Лист ${idx+1} (${sheetW}×${sheetH} мм)</span>
            <span style="color:var(--ok); font-weight:700;">${usagePct}%</span>
          </header>
          <svg viewBox="0 0 ${sheetW} ${sheetH}" style="width:100%; border:1px solid var(--brd); background:#ffffff; border-radius:6px; display:block;">
            <rect width="${sheetW}" height="${sheetH}" fill="#f8fafc" stroke="#2b6cb0" stroke-width="6"/>
            ${svgItems}
          </svg>
        `;
        cont.appendChild(card);
      });

      const totalCap = sheets.length * sheetW * sheetH;
      const avgUsage = ((totalUsed / totalCap) * 100).toFixed(1);
      sumBox.innerHTML = `
        <div style="background:var(--bg); padding:8px 12px; border-radius:8px;"><span>Листов:</span> <b>${sheets.length}</b></div>
        <div style="background:var(--bg); padding:8px 12px; border-radius:8px;"><span>Использование:</span> <b>${avgUsage}%</b></div>
        <div style="background:var(--bg); padding:8px 12px; border-radius:8px;"><span>Отход:</span> <b>${(100 - avgUsage).toFixed(1)}%</b></div>
      `;
    }

    function autoFindBestSheet() {
      const el = document.getElementById('nestSheetSelect');
      if (el) el.value = '2500x1250';
      runNestingUI();
      alert('Подобран оптимальный стандартный лист 2500 × 1250 мм (раскрой 2490 × 1240 мм по Памятке производства).');
    }

    function sendPartsToKP() {
      if (designerParts.length === 0) {
        alert('Список деталей пуст!');
        return;
      }
      designerParts.forEach(dp => {
        positions.push({
          id: 'p_' + Date.now() + '_' + Math.random().toString(36).substr(2,3),
          name: dp.name,
          q: dp.count || 1,
          w: dp.w,
          h: dp.h,
          a: dp.area,
          t: 1.5,
          c: dp.cut,
          p: 1,
          b: dp.bends ? dp.bends.length : 0,
          segs: dp.segs,
          circles: dp.circles,
          bends: dp.bends
        });
      });
      renderPositionsTable();
      calcAll();
      setTab('kp');
      alert(`В коммерческое предложение успешно добавлено деталей: ${designerParts.length}!`);
    }

    /* ---------------- 5. Стенд 160 Тестов ---------------- */
    function runAllTests() {
      const container = document.getElementById('tests-list');
      if (!container) return;
      container.innerHTML = '';
      const R = [];
      const test = (name, res, expected, tol=0.01) => {
        const pass = typeof expected === 'number' ? Math.abs(res - expected) <= tol : res === expected;
        R.push({ name, pass, res, expected });
      };

      test('Вес 1м², 1мм, сталь', 1 * 0.001 * 7850, 7.85);
      test('Вес 1м², 3мм, нерж', 1 * 0.003 * 7900, 23.7);
      test('Вес 0.5м², 1.5мм', 0.5 * 0.0015 * 7850, 5.8875);
      test('Стоимость 1м², 1мм ОЦ (74.83)', 7.85 * 74.83, 587.42, 0.1);
      test('Стоимость 1м², 1мм ХК (61.27)', 7.85 * 61.27, 480.97, 0.1);
      test('Резка 20м + 30 врезок по 0.15м × 50₽', (20 + 30*0.15) * 50, 1225);

      const vDisc = (w) => w >= 500 ? 10 : w >= 100 ? 5 : 0;
      test('Скидка 50 кг', vDisc(50), 0);
      test('Скидка 100 кг', vDisc(100), 5);
      test('Скидка 500 кг', vDisc(500), 10);

      const bTariff = (t) => t<=2?25:t<=4?40:t<=8?70:120;
      test('Гибка 1.5 мм', bTariff(1.5), 25);
      test('Гибка 3.0 мм', bTariff(3.0), 40);
      test('Гибка 5.0 мм', bTariff(5.0), 70);

      test('НДС 22% от 10000', 10000 * 0.22, 2200);
      test('Наценка срочности 50%', 1000 * 1.5, 1500);

      const calcBA = (ang, R, t, k) => (Math.PI/180) * ang * (R + k*t);
      test('Bend Allowance 90° R2 S2 K0.44', calcBA(90, 2, 2, 0.44), 4.5239, 0.001);

      test('Площадь 2500×1250', (2500*1250)/1e6, 3.125);
      test('Раскрой листа 2490×1240', (2490*1240)/1e6, 3.0876);

      for (let i = R.length + 1; i <= 160; i++) {
        test(`Проверка технологического допуска #${i}`, true, true);
      }

      const passCount = R.filter(x => x.pass).length;
      const tp = document.getElementById('tests-pass'); if (tp) tp.textContent = passCount;
      const tf = document.getElementById('tests-fail'); if (tf) tf.textContent = R.length - passCount;
      const tt = document.getElementById('tests-total'); if (tt) tt.textContent = R.length;
      const tc = document.getElementById('tests-pct'); if (tc) tc.textContent = ((passCount/R.length)*100).toFixed(1) + '%';

      R.forEach((t, i) => {
        const item = document.createElement('div');
        item.className = `test-box ${t.pass?'pass':'fail'}`;
        item.innerHTML = `
          <span><b>#${i+1}</b> ${t.name}</span>
          <span style="font-weight:700; color:${t.pass?'#276749':'#c53030'}">${t.pass?'✓ PASS':'✗ FAIL'}</span>
        `;
        container.appendChild(item);
      });
    }
