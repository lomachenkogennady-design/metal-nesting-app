    function closePosModal() {
      const modal = document.getElementById('pos-modal');
      if (modal) modal.style.display = 'none';
      if (pmAnimFrame) cancelAnimationFrame(pmAnimFrame);
    }

    function switchModalView(v) {
      pmModalView = v;
      ['2d', '3d', 'bend'].forEach(m => {
        const el = document.getElementById(`pos-modal-v-${m}`);
        const btn = document.getElementById(`pos-modal-btn-${m}`);
        if (el) el.style.display = m === v ? 'block' : 'none';
        if (btn) btn.classList.toggle('active', m === v);
      });

      const pos = positions[modalPosIndex];
      if (!pos) return;

      if (v === '2d') {
        renderPosModal2D(pos);
      } else if (v === '3d') {
        renderPosModal3D(pos);
      } else if (v === 'bend') {
        renderPosModalBend(pos);
      }
    }

    function renderPosModal2D(pos) {
      initPosModalInteraction();
      const svg = document.getElementById('pos-modal-svg');
      if (!svg) return;
      const W = 760, H = 400;
      const padLeft = 70, padRight = 35, padBottom = 55, padTop = 45;
      const availW = W - padLeft - padRight;
      const availH = H - padTop - padBottom;

      const baseScale = Math.min(availW / Math.max(1, pos.w), availH / Math.max(1, pos.h));
      const scale = baseScale * pmZoom2D;

      let content = `<rect width="${W}" height="${H}" fill="#ffffff"/>`;
      content += `<defs><pattern id="pmGrid" width="20" height="20" patternUnits="userSpaceOnUse"><path d="M 20 0 L 0 0 0 20" fill="none" stroke="#f0f3f8" stroke-width="1"/></pattern></defs><rect width="${W}" height="${H}" fill="url(#pmGrid)"/>`;

      const centerX = padLeft + availW / 2 + pmPan2D.x;
      const centerY = padTop + availH / 2 + pmPan2D.y;
      const ox = centerX - (pos.w * scale) / 2;
      const oy = centerY - (pos.h * scale) / 2;

      // Оси симметрии
      content += `<g stroke="#cbd5e0" stroke-width="0.8" stroke-dasharray="8 4 2 4">
        <line x1="${centerX}" y1="${oy - 18}" x2="${centerX}" y2="${oy + pos.h*scale + 18}" />
        <line x1="${ox - 18}" y1="${centerY}" x2="${ox + pos.w*scale + 18}" y2="${centerY}" />
      </g>`;

      // Контуры
      content += `<g stroke="#1a365d" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">`;
      if (pos.segs && pos.segs.length > 0) {
        pos.segs.forEach(s => {
          content += `<line x1="${ox + s.x1*scale}" y1="${oy + s.y1*scale}" x2="${ox + s.x2*scale}" y2="${oy + s.y2*scale}"/>`;
        });
      } else {
        content += `<rect x="${ox}" y="${oy}" width="${pos.w*scale}" height="${pos.h*scale}" fill="rgba(49,130,206,0.15)"/>`;
      }
      content += `</g>`;

      // Отверстия
      if (pos.circles && pos.circles.length > 0) {
        content += `<g stroke="#c05621" stroke-width="1.6" fill="none">`;
        pos.circles.forEach(c => {
          const cx = ox + c.cx * scale;
          const cy = oy + c.cy * scale;
          const r = Math.max(1, c.r * scale);
          content += `<circle cx="${cx}" cy="${cy}" r="${r}" fill="#ffffff"/>`;
          content += `<line x1="${cx - r - 4}" y1="${cy}" x2="${cx + r + 4}" y2="${cy}" stroke="#c05621" stroke-dasharray="4,2" stroke-width="0.8"/>`;
          content += `<line x1="${cx}" y1="${cy - r - 4}" x2="${cx}" y2="${cy + r + 4}" stroke="#c05621" stroke-dasharray="4,2" stroke-width="0.8"/>`;
        });
        content += `</g>`;
      }

      // Линии гиба
      if (pos.bends && pos.bends.length > 0) {
        pos.bends.forEach((b) => {
          const bx = ox + (b.pos || b.position || 0) * scale;
          content += `
            <line x1="${bx}" y1="${oy - 4}" x2="${bx}" y2="${oy + pos.h*scale + 4}" stroke="#c05621" stroke-width="1.8" stroke-dasharray="6,4"/>
            <text x="${bx}" y="${oy - 7}" text-anchor="middle" fill="#c05621" font-size="9" font-weight="bold">${b.angle>0?'▲':'▼'} ${b.angle}°</text>
          `;
        });
      }

      // Размеры
      const x0 = ox, x1 = ox + pos.w * scale;
      const y0 = oy + pos.h * scale, y1 = oy;

      content += `<g stroke="#2b6cb0" stroke-width="1" fill="#2b6cb0" font-size="11" font-family="sans-serif">
        <line x1="${x0}" y1="${y0 + 16}" x2="${x1}" y2="${y0 + 16}"/>
        <line x1="${x0}" y1="${y0 + 10}" x2="${x0}" y2="${y0 + 22}"/>
        <line x1="${x1}" y1="${y0 + 10}" x2="${x1}" y2="${y0 + 22}"/>
        <text x="${(x0 + x1)/2}" y="${y0 + 30}" text-anchor="middle" font-weight="600" stroke="none">${pos.w} мм</text>

        <line x1="${x0 - 16}" y1="${y0}" x2="${x0 - 16}" y2="${y1}"/>
        <line x1="${x0 - 22}" y1="${y0}" x2="${x0 - 10}" y2="${y0}"/>
        <line x1="${x0 - 22}" y1="${y1}" x2="${x0 - 10}" y2="${y1}"/>
        <text x="${x0 - 24}" y="${(y0 + y1)/2}" text-anchor="middle" font-weight="600" stroke="none" transform="rotate(-90 ${x0 - 24} ${(y0 + y1)/2})">${pos.h} мм</text>
      </g>`;

      content += `<g font-family="sans-serif" fill="#4a5568">
        <text x="20" y="24" font-size="13" font-weight="700" fill="#1a365d">${pos.name}</text>
        <text x="20" y="38" font-size="10" fill="#718096">Масштаб 1:${Math.max(1, Math.round(1/scale))} · Окно: ${Math.round(pmZoom2D*100)}%</text>
      </g>`;

      svg.innerHTML = content;
    }

    function initPosModalInteraction() {
      const wrap = document.getElementById('pos-modal-svg-wrap');
      if (!wrap || wrap._inited) return;
      wrap._inited = true;

      wrap.addEventListener('pointerdown', (e) => {
        pmIsDragging = true;
        pmStartPtr = { x: e.clientX, y: e.clientY };
        wrap.setPointerCapture(e.pointerId);
        wrap.style.cursor = 'grabbing';
      });

      wrap.addEventListener('pointermove', (e) => {
        if (!pmIsDragging) return;
        const dx = e.clientX - pmStartPtr.x;
        const dy = e.clientY - pmStartPtr.y;
        pmStartPtr = { x: e.clientX, y: e.clientY };
        pmPan2D.x += dx;
        pmPan2D.y += dy;
        const pos = positions[modalPosIndex];
        if (pos) renderPosModal2D(pos);
      });

      const stopDrag = () => {
        pmIsDragging = false;
        if (wrap) wrap.style.cursor = 'grab';
      };
      wrap.addEventListener('pointerup', stopDrag);
      wrap.addEventListener('pointercancel', stopDrag);

      wrap.addEventListener('wheel', (e) => {
        e.preventDefault();
        const factor = e.deltaY < 0 ? 1.15 : 0.87;
        pmZoom2D = Math.max(0.15, Math.min(12, pmZoom2D * factor));
        const pos = positions[modalPosIndex];
        if (pos) renderPosModal2D(pos);
      }, { passive: false });
    }

    function fitPosModal2D() {
      pmZoom2D = 1;
      pmPan2D = { x: 0, y: 0 };
      const pos = positions[modalPosIndex];
      if (pos) renderPosModal2D(pos);
    }
    function zoomPosModal2D(f) {
      pmZoom2D = Math.max(0.15, Math.min(12, pmZoom2D * f));
      const pos = positions[modalPosIndex];
      if (pos) renderPosModal2D(pos);
    }
    function exportPosModalSVG() {
      const svg = document.getElementById('pos-modal-svg')?.outerHTML;
      if (!svg) return;
      const blob = new Blob([svg], { type: 'image/svg+xml' });
      const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = `${positions[modalPosIndex]?.name||'деталь'}-2D.svg`; a.click();
    }
    function exportPosModalPNG() {
