function doLoadJSON(ev){
  var f=ev.target.files[0];
  if(!f)return;
  var r=new FileReader();
  r.onload=function(e){
    try{
      var data=JSON.parse(e.target.result);
      if(data.fields){
        Object.keys(data.fields).forEach(function(k){
          var el=$(k);
          if(!el)return;
          if(typeof data.fields[k]==='boolean')el.checked=data.fields[k];
          else el.value=data.fields[k];
        });
      }
      if(Array.isArray(data.positions)&&data.positions.length){
        pos=data.positions;
        if(typeof rP==='function')rP();
      }
      if(typeof calc==='function')calc();
      alert('OK: загружено '+(data.positions?data.positions.length:0)+' поз.');
    }catch(err){
      alert('Ошибка загрузки: '+err.message);
    }
  };
  r.readAsText(f);
}
