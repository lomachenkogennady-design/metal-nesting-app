// ЭКСПОРТ CSV
function csv(){
  var rows=[['Позиция','Наименование','Кол-во','Пл.м2','Толщ','Рез м','Врез','Гибов','Сумма']];
  pos.forEach(function(p,i){
    var s=parseFloat((($('s'+i)?$('s'+i).innerText:'0')||'0').replace(/[^0-9.,-]/g,'').replace(',','.'))||0;
    rows.push([i+1,p.n,p.q,p.a,p.t,p.c,p.p,p.b,s]);
  });
  var csvTxt='\uFEFF'+rows.map(function(r){return r.map(function(x){return '"'+String(x).replace(/"/g,'""')+'"'}).join(';')}).join('\n');
  dl(new Blob([csvTxt],{type:'text/csv;charset=utf-8'}),'KP_'+$('dNum').value+'.csv');
}

function dl(blob,name){
  var a=document.createElement('a');
  a.href=URL.createObjectURL(blob);
  a.download=name;
  a.click();
  URL.revokeObjectURL(a.href);
}

