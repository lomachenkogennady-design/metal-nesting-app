  var fields=['cName','cINN','cOGRN','cAddr','cPhone','cEmail','cBank','cRS','cKS','cBIK','dNum','dDate','dValid','dTerm','kName','kINN','kAddr','mName','mPhone','prepay','payTerms','mat','cPrice','matDate','dens','cutType','cutP','piF','b1','b2','b3','b4','pArea','pPrice','pType','drC','drP','znC','znP','wC','wP','tapC','tapP','del','oth','urg','disc','minO','vatR'];
  data.fields={};
