<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ФАЙЕРПРОМ — Производственный калькулятор КП</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Inter', sans-serif; }
    body { background: #eef1f6; color: #2d3748; padding: 18px; }
    .container { max-width: 1080px; margin: 0 auto; background: #fff; padding: 32px; border-radius: 14px; box-shadow: 0 6px 24px rgba(0,0,0,.07); }

    .brandbar { display: flex; justify-content: space-between; align-items: center; gap: 14px; padding-bottom: 16px; border-bottom: 2px solid #e2e8f0; margin-bottom: 22px; flex-wrap: wrap; }
    .brand-left { display: flex; align-items: center; gap: 12px; }
    .logo-svg { width: 42px; height: 42px; flex: 0 0 auto; }
    .brand-text h1 { font-size: 20px; color: #1a202c; font-weight: 700; line-height: 1.15; }
    .brand-text p { font-size: 12px; color: #718096; margin-top: 2px; }
    .brand-tag { font-size: 12px; font-weight: 700; color: #c05621; background: #fffaf0; padding: 6px 12px; border-radius: 6px; border: 1px solid #fbd38d; letter-spacing: .5px; }

    .section { margin-bottom: 18px; padding: 18px; background: #f8fafc; border-radius: 10px; border: 1px solid #e2e8f0; }
    .section h2 { font-size: 14px; margin-bottom: 14px; color: #2b6cb0; font-weight: 700; letter-spacing: .3px; text-transform: uppercase; display: flex; align-items: center; gap: 8px; }
    .section h2::before { content: ''; display: inline-block; width: 4px; height: 16px; background: #3182ce; border-radius: 2px; }

    .form-group { margin-bottom: 12px; }
    label { display: block; font-size: 12.5px; font-weight: 500; margin-bottom: 5px; color: #4a5568; }
    select, input[type="number"], input[type="text"], input[type="date"] {
        width: 100%; padding: 10px 12px; border: 1px solid #cbd5e0; border-radius: 7px;
        font-size: 14px; background: #fff; color: #2d3748; transition: border-color .15s, box-shadow .15s;
    }
    select:focus, input:focus { outline: none; border-color: #3182ce; box-shadow: 0 0 0 3px rgba(49,130,206,.12); }
    .row { display: flex; gap: 14px; flex-wrap: wrap; }
    .row .form-group { flex: 1 1 160px; margin-bottom: 0; }
    .row + .row { margin-top: 12px; }

    .check-line { display: flex; align-items: center; gap: 9px; font-size: 13.5px; color: #4a5568; margin-bottom: 10px; }
    .check-line input[type="checkbox"] { width: 17px; height: 17px; accent-color: #3182ce; cursor: pointer; }
    .check-line label { margin: 0; cursor: pointer; font-weight: 500; font-size: 13.5px; }
    .hint { font-size: 11.5px; color: #718096; margin-top: 4px; }

    .btn-group { display: flex; gap: 12px; margin-top: 22px; flex-wrap: wrap; }
    button { flex: 1 1 180px; background: #3182ce; color: #fff; border: none; padding: 13px 20px; font-size: 14.5px; font-weight: 600; border-radius: 8px; cursor: pointer; transition: background .2s, transform .05s; }
    button:hover { background: #2b6cb0; }
    button:active { transform: scale(.98); }
    button.secondary { background: #4a5568; }
    button.secondary:hover { background: #2d3748; }
    button.ghost { background: #fff; color: #2b6cb0; border: 1.5px solid #3182ce; }
    button.ghost:hover { background: #ebf8ff; }

    .results { margin-top: 24px; background: #ebf8ff; border: 1px solid #bee3f8; padding: 22px; border-radius: 10px; }
    .results h3 { font-size: 17px; margin-bottom: 14px; color: #2b6cb0; font-weight: 700; }
    .result-item { display: flex; justify-content: space-between; gap: 14px; margin-bottom: 8px; font-size: 14.5px; }
    .result-item span:last-child { font-weight: 600; color: #1a202c; white-space: nowrap; }
    .result-item.sub { font-size: 13px; color: #5a6b80; padding-left: 16px; }
    .result-item.sub span:last-child { font-weight: 500; color: #5a6b80; }
    .result-item.total { font-size: 18px; color: #2c5282; font-weight: 700; border-top: 1px solid #bee3f8; padding-top: 12px; margin-top: 10px; }
    .result-item.total span:last-child { color: #2c5282; font-weight: 700; }
    .result-item.vat { color: #92400e; }
    .result-item.vat span:last-child { color: #92400e; }
    .result-item.grand { font-size: 20px; color: #22543d; font-weight: 700; margin-top: 6px; padding-top: 8px; border-top: 1px dashed #86efac; }
    .result-item.grand span:last-child { color: #22543d; font-weight: 800; }
    .result-item.unit { font-size: 14.5px; color: #276749; }
    .result-item.unit span:last-child { color: #276749; }

    .print-only { display: none; }
    @media print {
        @page { margin: 15mm; }
        body { background: #fff; padding: 0; font-size: 12px; color: #000; }
        .container { box-shadow: none; padding: 0; max-width: 100%; border-radius: 0; }
        .no-print, .section, .btn-group, .results, .brandbar { display: none !important; }
        .print-only { display: block !important; }
        .print-only .p-head { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2.5px solid #000; padding-bottom: 12px; margin-bottom: 16px; }
        .print-only .p-logo { width: 60px; height: 60px; }
        .print-only h1 { font-size: 18px; margin-bottom: 3px; }
        .print-only .p-sub { font-size: 11.5px; color: #444; }
        .print-only .p-meta { text-align: right; font-size: 11.5px; line-height: 1.6; }
        .print-only table { width: 100%; border-collapse: collapse; margin-bottom: 14px; page-break-inside: avoid; }
        .print-only th, .print-only td { border: 1px solid #999; padding: 6px 9px; text-align: left; font-size: 11.5px; vertical-align: top; }
        .print-only th { background: #f0f0f0; font-weight: 700; }
        .print-only td:last-child { text-align: right; white-space: nowrap; }
        .print-only .tr-total td { font-weight: 700; background: #f7f7f7; font-size: 12.5px; }
        .print-only .tr-grand td { font-weight: 800; background: #e6f4ea; font-size: 13.5px; }
        .print-only .p-note { font-size: 10.5px; color: #555; margin-top: 16px; line-height: 1.6; border-top: 1px solid #ccc; padding-top: 10px; }
        .print-only .p-sign { margin-top: 30px; display: flex; justify-content: space-between; font-size: 11.5px; }
        .print-only .p-sign div { border-top: 1px solid #000; width: 45%; padding-top: 4px; }
    }
</style>
</head>
<body>

<div class="container">

    <div class="brandbar no-print">
        <div class="brand-left">
            <svg class="logo-svg" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
                <rect x="4" y="4" width="56" height="56" rx="10" fill="#3182ce"/>
                <path d="M18 46 L32 18 L46 46 L38 46 L32 34 L26 46 Z" fill="#fff"/>
                <circle cx="32" cy="26" r="3" fill="#f6ad55"/>
            </svg>
            <div class="brand-text">
                <h1>Производственный расчёт КП</h1>
                <p>Металлообработка · Лазерная резка · Гибка · Покраска</p>
            </div>
        </div>
        <div class="brand-tag">ФАЙЕРПРОМ</div>
    </div>

    <div class="section no-print">
        <h2>Реквизиты коммерческого предложения</h2>
        <div class="row">
            <div class="form-group">
                <label for="docNumber">Номер КП:</label>
                <input type="text" id="docNumber" value="КП-0001" oninput="calculate()">
            </div>
            <div class="form-group">
                <label for="docDate">Дата:</label>
                <input type="date" id="docDate" oninput="calculate()">
            </div>
            <div class="form-group">
                <label for="docValidity">Действительно до:</label>
                <input type="date" id="docValidity" oninput="calculate()">
            </div>
        </div>
        <div class="row">
            <div class="form-group">
                <label for="docClient">Заказчик:</label>
                <input type="text" id="docClient" placeholder="ООО «Название»" oninput="calculate()">
            </div>
            <div class="form-group">
                <label for="docManager">Менеджер:</label>
                <input type="text" id="docManager" placeholder="Иванов И.И." oninput="calculate()">
            </div>
            <div class="form-group">
                <label for="docPhone">Телефон:</label>
                <input type="text" id="docPhone" placeholder="+7 (___) ___-__-__" oninput="calculate()">
            </div>
        </div>
    </div>

    <div class="section">
        <h2>1. Материал и раскрой</h2>
        <div class="form-group">
            <label for="material">Марка металла:</label>
            <select id="material" onchange="calculate()">
                <option value="galvanized">Оцинкованная сталь (ОЦ) — 74.83 ₽/кг</option>
                <option value="coldRolled">Холоднокатаная сталь (ХК) — 61.27 ₽/кг</option>
                <option value="stainless">Нержавеющая сталь AISI 304 — 311.47 ₽/кг</option>
                <option value="hotRolled">Горячекатаная сталь (ГК) — 65.00 ₽/кг</option>
                <option value="aluminum">Алюминий АМг2 — 320.00 ₽/кг</option>
                <option value="copper">Медь М1 — 780.00 ₽/кг</option>
            </select>
        </div>
        <div class="row">
            <div class="form-group">
                <label for="thickness">Толщина (мм, 0.5–25):</label>
                <input type="number" id="thickness" min="0.5" max="25" step="0.1" value="1.5" oninput="calculate()" onchange="normalize(this)">
            </div>
            <div class="form-group">
                <label for="usedArea">Чистая площадь деталей (м²):</label>
                <input type="number" id="usedArea" min="0.01" step="0.01" value="2.0" oninput="calculate()" onchange="normalize(this)">
            </div>
            <div class="form-group">
                <label for="remnantArea">Ликвидный остаток / отход (м²):</label>
                <input type="number" id="remnantArea" min="0" step="0.01" value="0.5" oninput="calculate()" onchange="normalize(this)">
            </div>
        </div>
        <div class="check-line" style="margin-top:12px;">
            <input type="checkbox" id="includeRemnant" checked onchange="calculate()">
            <label for="includeRemnant">Включать остаток в стоимость металла</label>
        </div>
    </div>

    <div class="section">
        <h2>2. Лазерная / плазменная резка</h2>
        <div class="row">
            <div class="form-group">
                <label for="cutLength">Длина реза (пог. м):</label>
                <input type="number" id="cutLength" min="0" step="0.5" value="20" oninput="calculate()" onchange="normalize(this)">
            </div>
            <div class="form-group">
                <label for="piercesCount">Количество врезок:</label>
                <input type="number" id="piercesCount" min="0" step="1" value="30" oninput="calculate()" onchange="normalize(this)">
            </div>
            <div class="form-group">
                <label for="cutPricePerM">Цена 1 пог. м реза (₽):</label>
                <input type="number" id="cutPricePerM" min="0" step="1" value="50" oninput="calculate()" onchange="normalize(this)">
            </div>
        </div>
        <div class="form-group" style="margin-top:12px;">
            <label for="pierceFactor">Эквивалент врезки (пог. м на 1 врезку):</label>
            <input type="number" id="pierceFactor" min="0" step="0.01" value="0.15" oninput="calculate()" onchange="normalize(this)">
            <div class="hint">По умолчанию 1 врезка ≈ 0.15 м реза. Меняется под станок.</div>
        </div>
    </div>

    <div class="section">
        <h2>3. Дополнительные работы</h2>
        <div class="row">
            <div class="form-group">
                <label for="bendsCount">Количество гибов (шт):</label>
                <input type="number" id="bendsCount" min="0" step="1" value="12" oninput="calculate()" onchange="normalize(this)">
            </div>
            <div class="form-group">
                <label for="bendPrice">Цена 1 гиба (₽):</label>
                <input type="number" id="bendPrice" min="0" step="1" value="30" oninput="calculate()" onchange="normalize(this)">
            </div>
        </div>
        <div class="row">
            <div class="form-group">
                <label for="paintArea">Площадь покраски (м²):</label>
                <input type="number" id="paintArea" min="0" step="0.01" value="0" oninput="calculate()" onchange="normalize(this)">
            </div>
            <div class="form-group">
                <label for="paintPrice">Цена покраски (₽/м²):</label>
                <input type="number" id="paintPrice" min="0" step="10" value="350" oninput="calculate()" onchange="normalize(this)">
            </div>
            <div class="form-group">
                <label for="deliveryCost">Доставка (₽, 0 — самовывоз):</label>
                <input type="number" id="deliveryCost" min="0" step="100" value="0" oninput="calculate()" onchange="normalize(this)">
            </div>
            <div class="form-group">
                <label for="otherCost">Прочие работы (₽):</label>
                <input type="number" id="otherCost" min="0" step="100" value="0" oninput="calculate()" onchange="normalize(this)">
            </div>
        </div>
    </div>

    <div class="section">
        <h2>4. Партия, наценки и налоги</h2>
        <div class="row">
            <div class="form-group">
                <label for="quantity">Количество изделий (шт):</label>
                <input type="number" id="quantity" min="1" step="1" value="1" oninput="calculate()" onchange="normalize(this)">
            </div>
            <div class="form-group">
                <label for="urgencyMarkup">Срочность / наценка (%):</label>
                <input type="number" id="urgencyMarkup" min="0" max="200" step="5" value="0" oninput="calculate()" onchange="normalize(this)">
            </div>
            <div class="form-group">
                <label for="discount">Скидка (%):</label>
                <input type="number" id="discount" min="0" max="100" step="1" value="0" oninput="calculate()" onchange="normalize(this)">
            </div>
            <div class="form-group">
                <label for="minOrder">Мин. сумма заказа (₽, 0 — нет):</label>
                <input type="number" id="minOrder" min="0" step="100" value="0" oninput="calculate()" onchange="normalize(this)">
            </div>
        </div>
        <div class="check-line" style="margin-top:12px;">
            <input type="checkbox" id="vatEnabled" checked onchange="calculate()">
            <label for="vatEnabled">Добавить НДС 22%</label>
        </div>
    </div>

    <div class="results no-print" id="resultsBlock"></div>

    <div class="btn-group no-print">
        <button onclick="window.print()">🖨️ Печать / Сохранить PDF (КП)</button>
        <button class="ghost" onclick="exportCSV()">📊 Экспорт в CSV</button>
        <button class="ghost" onclick="saveLocal()">💾 Сохранить</button>
        <button class="ghost" onclick="loadLocal()">📂 Загрузить</button>
        <button class="secondary" onclick="resetForm()">↺ Сбросить</button>
    </div>

    <div class="print-only" id="printSpec"></div>
</div>

<script>
const MATERIALS = {
    galvanized: { name: 'Оцинкованная сталь (ОЦ)',     density: 7850, price: 74.83  },
    coldRolled: { name: 'Холоднокатаная сталь (ХК)',   density: 7850, price: 61.27  },
    stainless:  { name: 'Нержавеющая сталь AISI 304',  density: 7900, price: 311.47 },
    hotRolled:  { name: 'Горячекатаная сталь (ГК)',    density: 7850, price: 65.00  },
    aluminum:   { name: 'Алюминий АМг2',               density: 2700, price: 320.00 },
    copper:     { name: 'Медь М1',                     density: 8900, price: 780.00 }
};
const VAT_RATE = 0.22;
const LS_KEY = 'fayerprom_kp_v1';

const $ = id => document.getElementById(id);
const fmt = n => (Math.round(n * 100) / 100).toLocaleString('ru-RU', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const fmtNum = (n, d = 2) => n.toLocaleString('ru-RU', { minimumFractionDigits: 0, maximumFractionDigits: d });
const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

function getVal(id, min = 0, max = null, fallback = 0) {
    const el = $(id);
    let v = parseFloat(String(el.value).replace(',', '.'));
    if (!isFinite(v)) v = fallback;
    if (v < min) v = min;
    if (max !== null && v > max) v = max;
    return v;
}

function normalize(el) {
    const min = el.min !== '' ? parseFloat(el.min) : -Infinity;
    const max = el.max !== '' ? parseFloat(el.max) : Infinity;
    let v = parseFloat(String(el.value).replace(',', '.'));
    if (!isFinite(v)) v = isFinite(min) ? min : 0;
    v = Math.min(Math.max(v, min), max);
    el.value = Math.round(v * 10000) / 10000;
    calculate();
}

function calculate() {
    const mat = MATERIALS[$('material').value] || MATERIALS.galvanized;

    const thickness    = getVal('thickness', 0.5, 25, 1.5);
    const usedArea     = getVal('usedArea', 0.01, null, 0);
    const remnantArea  = getVal('remnantArea', 0, null, 0);
    const includeRemn  = $('includeRemnant').checked;

    const cutLength    = getVal('cutLength', 0);
    const pierces      = getVal('piercesCount', 0);
    const cutPrice     = getVal('cutPricePerM', 0);
    const pierceFactor = getVal('pierceFactor', 0);

    const bends        = getVal('bendsCount', 0);
    const bendPrice    = getVal('bendPrice', 0);

    const paintArea    = getVal('paintArea', 0);
    const paintPrice   = getVal('paintPrice', 0);
    const delivery     = getVal('deliveryCost', 0);
    const otherCost    = getVal('otherCost', 0);

    const quantity     = Math.max(1, getVal('quantity', 1, null, 1));
    const urgency      = getVal('urgencyMarkup', 0, 200);
    const discount     = getVal('discount', 0, 100);
    const minOrder     = getVal('minOrder', 0);
    const vatEnabled   = $('vatEnabled').checked;

    const paidArea  = includeRemn ? (usedArea + remnantArea) : usedArea;
    const volumeM3  = paidArea * (thickness / 1000);
    const weightKg  = volumeM3 * mat.density;
    const metalCost = weightKg * mat.price;

    const cutEquivalent = cutLength + pierces * pierceFactor;
    const cutCost       = cutEquivalent * cutPrice;

    const bendCost = bends * bendPrice;
    const paintCost = paintArea * paintPrice;
    const extraCost = otherCost + delivery;

    const subTotal = metalCost + cutCost + bendCost + paintCost + extraCost;

    const markupCost  = subTotal * (urgency / 100);
    const afterMarkup = subTotal + markupCost;

    const discountCost  = afterMarkup * (discount / 100);
    const afterDiscount = afterMarkup - discountCost;

    const batchBeforeMin   = afterDiscount * quantity;
    const appliedMinOrder  = minOrder > 0 && batchBeforeMin < minOrder;
    const batchFinal       = appliedMinOrder ? minOrder : batchBeforeMin;
    const perItemFinal     = batchFinal / quantity;

    const vatAmount  = vatEnabled ? batchFinal * VAT_RATE : 0;
    const grandTotal = batchFinal + vatAmount;

    const isBatch = quantity > 1;
    const qtyLabel = isBatch ? ` × ${quantity} шт` : '';

    let html = `<h3>Сводная калькуляция стоимости:</h3>`;

    html += `<div class="result-item"><span>Масса металла (1 изделие):</span><span>${fmt(weightKg)} кг</span></div>`;
    if (isBatch) html += `<div class="result-item sub"><span>Масса партии:</span><span>${fmt(weightKg * quantity)} кг</span></div>`;
    html += `<div class="result-item"><span>Металл${qtyLabel}:</span><span>${fmt(metalCost * quantity)} ₽</span></div>`;
    html += `<div class="result-item"><span>Резка и врезки${qtyLabel}:</span><span>${fmt(cutCost * quantity)} ₽</span></div>`;
    html += `<div class="result-item"><span>Гибка${qtyLabel}:</span><span>${fmt(bendCost * quantity)} ₽</span></div>`;
    if (paintCost > 0) html += `<div class="result-item"><span>Покраска${qtyLabel}:</span><span>${fmt(paintCost * quantity)} ₽</span></div>`;
    if (delivery > 0)  html += `<div class="result-item"><span>Доставка:</span><span>${fmt(delivery)} ₽</span></div>`;
    if (otherCost > 0) html += `<div class="result-item"><span>Прочие работы${qtyLabel}:</span><span>${fmt(otherCost * quantity)} ₽</span></div>`;
    if (urgency > 0)   html += `<div class="result-item"><span>Наценка (${fmtNum(urgency,0)}%)${qtyLabel}:</span><span>${fmt(markupCost * quantity)} ₽</span></div>`;
    if (discount > 0)  html += `<div class="result-item"><span>Скидка (${fmtNum(discount,0)}%)${qtyLabel}:</span><span>− ${fmt(discountCost * quantity)} ₽</span></div>`;

    if (appliedMinOrder) {
        html += `<div class="result-item"><span>Сумма по расчёту:</span><span>${fmt(batchBeforeMin)} ₽</span></div>`;
        html += `<div class="result-item"><span>Применён мин. заказ:</span><span>${fmt(minOrder)} ₽</span></div>`;
    }

    html += `<div class="result-item total"><span>Итого без НДС${isBatch ? ' (партия)' : ''}:</span><span>${fmt(batchFinal)} ₽</span></div>`;

    if (vatEnabled) {
        html += `<div class="result-item vat"><span>НДС 22%:</span><span>${fmt(vatAmount)} ₽</span></div>`;
        html += `<div class="result-item grand"><span>ИТОГО с НДС 22%:</span><span>${fmt(grandTotal)} ₽</span></div>`;
    }

    if (isBatch) {
        html += `<div class="result-item unit" style="margin-top:12px;"><span>Цена за 1 изделие без НДС:</span><span>${fmt(perItemFinal)} ₽</span></div>`;
        if (vatEnabled) html += `<div class="result-item unit"><span>Цена за 1 изделие с НДС:</span><span>${fmt(perItemFinal * (1 + VAT_RATE))} ₽</span></div>`;
    }

    $('resultsBlock').innerHTML = html;

    const docNumber = esc($('docNumber').value || '—');
    const docDate   = $('docDate').value ? new Date($('docDate').value).toLocaleDateString('ru-RU') : new Date().toLocaleDateString('ru-RU');
    const docValid  = $('docValidity').value ? new Date($('docValidity').value).toLocaleDateString('ru-RU') : '—';
    const docClient = esc($('docClient').value || '—');
    const docManager = esc($('docManager').value || '—');
    const docPhone  = esc($('docPhone').value || '—');

    let print = `
        <div class="p-head">
            <div style="display:flex;gap:14px;align-items:center;">
                <svg class="p-logo" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
                    <rect x="4" y="4" width="56" height="56" rx="10" fill="#3182ce"/>
                    <path d="M18 46 L32 18 L46 46 L38 46 L32 34 L26 46 Z" fill="#fff"/>
                    <circle cx="32" cy="26" r="3" fill="#f6ad55"/>
                </svg>
                <div>
                    <h1>Коммерческое предложение № ${docNumber}</h1>
                    <div class="p-sub">Производственный комплекс «ФАЙЕРПРОМ» · Металлообработка</div>
                </div>
            </div>
            <div class="p-meta">
                Дата: <b>${docDate}</b><br>
                Действительно до: <b>${docValid}</b>
            </div>
        </div>

        <table>
            <tr><th style="width:55%">Заказчик</th><td style="text-align:left;">${docClient}</td></tr>
            <tr><th>Менеджер</th><td style="text-align:left;">${docManager} · ${docPhone}</td></tr>
        </table>

        <table>
            <tr><th style="width:60%">Параметр изделия</th><th>Значение</th></tr>
            <tr><td>Марка металла</td><td>${esc(mat.name)}</td></tr>
            <tr><td>Толщина листа</td><td>${fmtNum(thickness,2)} мм</td></tr>
            <tr><td>Чистая площадь деталей</td><td>${fmtNum(usedArea,2)} м²</td></tr>
            <tr><td>Ликвидный остаток${includeRemn ? '' : ' (не оплачивается)'}</td><td>${fmtNum(includeRemn ? remnantArea : 0, 2)} м²</td></tr>
            <tr><td>Масса металла (1 изделие)</td><td>${fmt(weightKg)} кг</td></tr>
            <tr><td>Длина реза</td><td>${fmtNum(cutLength,2)} пог. м</td></tr>
            <tr><td>Количество врезок</td><td>${fmtNum(pierces,0)} шт</td></tr>
            <tr><td>Количество гибов</td><td>${fmtNum(bends,0)} шт</td></tr>
            ${paintArea > 0 ? `<tr><td>Площадь покраски</td><td>${fmtNum(paintArea,2)} м²</td></tr>` : ''}
            <tr><td>Количество изделий</td><td>${quantity} шт</td></tr>
        </table>

        <table>
            <tr><th style="width:60%">Статья затрат</th><th>Сумма, ₽</th></tr>
            <tr><td>Металл${qtyLabel}</td><td>${fmt(metalCost * quantity)}</td></tr>
            <tr><td>Резка и врезки${qtyLabel}</td><td>${fmt(cutCost * quantity)}</td></tr>
            <tr><td>Гибка${qtyLabel}</td><td>${fmt(bendCost * quantity)}</td></tr>`;

    if (paintCost > 0) print += `<tr><td>Покраска${qtyLabel}</td><td>${fmt(paintCost * quantity)}</td></tr>`;
    if (delivery > 0)  print += `<tr><td>Доставка</td><td>${fmt(delivery)}</td></tr>`;
    if (otherCost > 0) print += `<tr><td>Прочие работы${qtyLabel}</td><td>${fmt(otherCost * quantity)}</td></tr>`;
    if (urgency > 0)   print += `<tr><td>Наценка за срочность (${fmtNum(urgency,0)}%)</td><td>${fmt(markupCost * quantity)}</td></tr>`;
    if (discount > 0)  print += `<tr><td>Скидка (${fmtNum(discount,0)}%)</td><td>− ${fmt(discountCost * quantity)}</td></tr>`;
    if (appliedMinOrder) print += `<tr><td>Применён минимальный заказ</td><td>${fmt(minOrder)}</td></tr>`;

    print += `<tr class="tr-total"><td>Итого без НДС</td><td>${fmt(batchFinal)}</td></tr>`;

    if (vatEnabled) {
        print += `<tr><td>НДС 22%</td><td>${fmt(vatAmount)}</td></tr>`;
        print += `<tr class="tr-grand"><td>ВСЕГО к оплате с НДС 22%</td><td>${fmt(grandTotal)}</td></tr>`;
    } else {
        print += `<tr class="tr-grand"><td>ВСЕГО к оплате (без НДС)</td><td>${fmt(grandTotal)}</td></tr>`;
    }

    print += `</table>`;

    if (isBatch) {
        print += `<table>
            <tr><th style="width:60%">Цена за единицу</th><th>Сумма, ₽</th></tr>
            <tr><td>1 изделие без НДС</td><td>${fmt(perItemFinal)}</td></tr>`;
        if (vatEnabled) print += `<tr><td>1 изделие с НДС 22%</td><td>${fmt(perItemFinal * (1 + VAT_RATE))}</td></tr>`;
        print += `</table>`;
    }

    print += `
        <div class="p-note">
            Предложение действительно до ${docValid}.<br>
            Срок изготовления и условия оплаты уточняются при подтверждении заказа.<br>
            ${vatEnabled ? 'Цены указаны с учётом НДС 22%.' : 'Цены указаны без НДС.'}
        </div>
        <div class="p-sign">
            <div>Исполнитель: ${docManager}</div>
            <div>Заказчик: ${docClient}</div>
        </div>`;

    $('printSpec').innerHTML = print;
}

function exportCSV() {
    const rows = [
        ['Параметр', 'Значение'],
        ['Номер КП', $('docNumber').value],
        ['Дата', $('docDate').value],
        ['Заказчик', $('docClient').value],
        ['Менеджер', $('docManager').value],
        ['Телефон', $('docPhone').value],
        [''],
        ['Металл', MATERIALS[$('material').value].name],
        ['Толщина, мм', $('thickness').value],
        ['Площадь деталей, м²', $('usedArea').value],
        ['Остаток, м²', $('remnantArea').value],
        ['Длина реза, пог.м', $('cutLength').value],
        ['Врезок, шт', $('piercesCount').value],
        ['Гибов, шт', $('bendsCount').value],
        ['Количество изделий', $('quantity').value],
        ['НДС', $('vatEnabled').checked ? '22%' : 'без НДС'],
        [''],
        ['Итого без НДС, ₽', document.querySelector('#resultsBlock .result-item.total span:last-child')?.innerText || ''],
        ['Итого с НДС, ₽', document.querySelector('#resultsBlock .result-item.grand span:last-child')?.innerText || '']
    ];
    const csv = '\uFEFF' + rows.map(r => r.map(c => `"${String(c).replace(/"/g, '""')}"`).join(';')).join('\n');
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `KP_${$('docNumber').value || 'export'}.csv`;
    a.click();
    URL.revokeObjectURL(a.href);
}

const FIELD_IDS = ['docNumber','docDate','docValidity','docClient','docManager','docPhone',
    'material','thickness','usedArea','remnantArea','cutLength','piercesCount','cutPricePerM','pierceFactor',
    'bendsCount','bendPrice','paintArea','paintPrice','deliveryCost','otherCost',
    'quantity','urgencyMarkup','discount','minOrder'];

function saveLocal() {
    const data = {};
    FIELD_IDS.forEach(id => data[id] = $(id).value);
    data.includeRemnant = $('includeRemnant').checked;
    data.vatEnabled     = $('vatEnabled').checked;
    try {
        localStorage.setItem(LS_KEY, JSON.stringify(data));
        alert('✅ Данные сохранены');
    } catch (e) {
        alert('⚠️ Не удалось сохранить: ' + e.message);
    }
}

function loadLocal() {
    try {
        const raw = localStorage.getItem(LS_KEY);
        if (!raw) { alert('Сохранённых данных нет'); return; }
        const data = JSON.parse(raw);
        FIELD_IDS.forEach(id => { if (data[id] !== undefined) $(id).value = data[id]; });
        if (data.includeRemnant !== undefined) $('includeRemnant').checked = data.includeRemnant;
        if (data.vatEnabled     !== undefined) $('vatEnabled').checked     = data.vatEnabled;
        calculate();
        alert('📂 Данные загружены');
    } catch (e) {
        alert('⚠️ Ошибка загрузки: ' + e.message);
    }
}

function resetForm() {
    if (!confirm('Сбросить все параметры?')) return;
    $('docNumber').value   = 'КП-0001';
    $('docDate').value     = new Date().toISOString().slice(0, 10);
    const d = new Date(); d.setDate(d.getDate() + 14);
    $('docValidity').value = d.toISOString().slice(0, 10);
    $('docClient').value   = '';
    $('docManager').value  = '';
    $('docPhone').value    = '';

    $('material').value    = 'galvanized';
    $('thickness').value   = 1.5;
    $('usedArea').value    = 2.0;
    $('remnantArea').value = 0.5;
    $('includeRemnant').checked = true;

    $('cutLength').value    = 20;
    $('piercesCount').value = 30;
    $('cutPricePerM').value = 50;
    $('pierceFactor').value = 0.15;

    $('bendsCount').value   = 12;
    $('bendPrice').value    = 30;
    $('paintArea').value    = 0;
    $('paintPrice').value   = 350;
    $('deliveryCost').value = 0;
    $('otherCost').value    = 0;

    $('quantity').value      = 1;
    $('urgencyMarkup').value = 0;
    $('discount').value      = 0;
    $('minOrder').value      = 0;
    $('vatEnabled').checked  = true;

    calculate();
}

window.onload = function () {
    const today = new Date().toISOString().slice(0, 10);
    $('docDate').value = today;
    const d = new Date(); d.setDate(d.getDate() + 14);
    $('docValidity').value = d.toISOString().slice(0, 10);

    try {
        const raw = localStorage.getItem(LS_KEY);
        if (raw) {
            const data = JSON.parse(raw);
            FIELD_IDS.forEach(id => { if (data[id] !== undefined) $(id).value = data[id]; });
            if (data.includeRemnant !== undefined) $('includeRemnant').checked = data.includeRemnant;
            if (data.vatEnabled     !== undefined) $('vatEnabled').checked     = data.vatEnabled;
        }
    } catch (e) {}

    calculate();
};
</script>

