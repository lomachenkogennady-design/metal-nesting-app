{
  "name": "Metal Nesting App",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "postCreateCommand": "pip install -r requirements.txt",
  "portsAttributes": {
    "8000": {
      "label": "FastAPI App",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [8000]
}
